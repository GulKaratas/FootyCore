});

// Stat bar animation on scroll
function animateBars() {
  const bars = document.querySelectorAll('.bh .f, .ba .f');
  const obs = new IntersectionObserver(entries => {
    entries.forEach(e => {
      if (e.isIntersecting) {
        e.target.style.width = e.target.dataset.w;
        obs.unobserve(e.target);
      }
    });
  }, {threshold: 0.3});
  bars.forEach(b => {
    b.dataset.w = b.style.width;
    b.style.width = '0';
    obs.observe(b);
  });
}
animateBars();
</script>
