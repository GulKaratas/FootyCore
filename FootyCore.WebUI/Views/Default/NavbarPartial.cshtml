@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    string NavClass(string controller, string extra = "")
    {
        var active = string.Equals(currentController, controller, StringComparison.OrdinalIgnoreCase) ? "active" : "";
        return $"nl {extra} {active}".Trim();
    }
}
