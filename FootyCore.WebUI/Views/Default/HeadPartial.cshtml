<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>GoalZone — Premier League</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@400;500;600;700;800;900&family=Barlow:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
    <style>
            :root{
              --bg:#080d18;--bg2:#0c1220;--card:#111827;--card2:#16202f;--elevated:#1c2d42;
              --green:#00e676;--blue:#2979ff;--live:#ff1744;--gold:#ffd600;--yellow:#ffc107;--red:#f44336;
              --t1:#eef2ff;--t2:#7b96c4;--t3:#3d5478;--border:#1a2640;
              --r1:8px;--r2:12px;--r3:16px;
              --tr:all .22s cubic-bezier(.4,0,.2,1);
              --fd:'Barlow Condensed',sans-serif;--fb:'Barlow',sans-serif;
            }
            *,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
            html{scroll-behavior:smooth}
            body{font-family:var(--fb);background:var(--bg);color:var(--t1);min-height:100vh;
              background-image:
                radial-gradient(ellipse at 15% 0%,rgba(41,121,255,.07) 0%,transparent 55%),
                radial-gradient(ellipse at 85% 0%,rgba(0,230,118,.04) 0%,transparent 50%)}
            ::-webkit-scrollbar{width:5px}::-webkit-scrollbar-track{background:var(--bg)}
            ::-webkit-scrollbar-thumb{background:var(--elevated);border-radius:3px}
            a{text-decoration:none;color:inherit}img{display:block}

            /* ─── NAVBAR ─── */
            .nb{background:rgba(8,13,24,.96);backdrop-filter:blur(20px);border-bottom:1px solid var(--border);
              position:sticky;top:0;z-index:1000;box-shadow:0 2px 24px rgba(0,0,0,.5)}
            .nb-inner{max-width:1120px;margin:0 auto;padding:0 20px;
              display:flex;align-items:center;justify-content:space-between;gap:16px}
            .brand{display:flex;align-items:center;gap:10px;padding:14px 0}
            .brand-ico{width:34px;height:34px;background:linear-gradient(135deg,var(--green),var(--blue));
              border-radius:7px;display:flex;align-items:center;justify-content:center;font-size:17px}
            .brand-txt{font-family:var(--fd);font-size:21px;font-weight:800;letter-spacing:1px}
            .brand-txt span{color:var(--green)}
            .nav-links{display:flex}
            .nl{font-family:var(--fd);font-size:12px;font-weight:700;letter-spacing:1.5px;text-transform:uppercase;
              color:var(--t2);padding:22px 15px;position:relative;transition:var(--tr)}
            .nl::after{content:'';position:absolute;bottom:0;left:15px;right:15px;height:2px;
              background:var(--green);transform:scaleX(0);transition:var(--tr)}
            .nl:hover,.nl.active{color:var(--t1)}.nl:hover::after,.nl.active::after{transform:scaleX(1)}
            .nb-icons{display:flex;align-items:center;gap:5px}
            .ico-btn{width:36px;height:36px;background:var(--card);border:1px solid var(--border);
              border-radius:var(--r1);color:var(--t2);display:flex;align-items:center;
              justify-content:center;font-size:14px;transition:var(--tr)}
            .ico-btn:hover{background:var(--elevated);color:var(--t1);border-color:var(--blue)}
            .tog{background:var(--card);border:1px solid var(--border);border-radius:var(--r1);
              padding:7px 9px;color:var(--t1);cursor:pointer;line-height:1}
            .mob-menu{max-height:0;overflow:hidden;transition:max-height .3s ease}
            .mob-menu.open{max-height:320px}
            .mob-menu .nl{padding:14px 0;border-bottom:1px solid var(--border);display:block}

            .wrap{max-width:1120px;margin:0 auto;padding:0 20px}

            /* ─── LEAGUE HEADER ─── */
            .lg-head{background:linear-gradient(135deg,var(--bg2),var(--card));
              border-bottom:1px solid var(--border);padding:32px 0 24px;position:relative;overflow:hidden}
            .lg-head::before{content:'';position:absolute;top:-40%;right:-5%;width:380px;height:380px;
              background:radial-gradient(circle,rgba(0,230,118,.05) 0%,transparent 70%);pointer-events:none}
            .lg-badge{display:inline-flex;align-items:center;gap:7px;background:rgba(255,214,0,.09);
              border:1px solid rgba(255,214,0,.22);border-radius:20px;padding:4px 12px;
              font-family:var(--fd);font-size:11px;font-weight:700;letter-spacing:1px;color:var(--gold);
              text-transform:uppercase;margin-bottom:10px}
            .lg-title{font-family:var(--fd);font-size:clamp(26px,5vw,42px);font-weight:900;letter-spacing:.5px;line-height:1}
            .lg-sub{font-size:13px;color:var(--t2);margin-top:6px}
            .lg-stats{display:flex;gap:24px;align-items:flex-end;justify-content:flex-end;height:100%}
            .ls-num{font-family:var(--fd);font-size:30px;font-weight:800;color:var(--green);line-height:1}
            .ls-lbl{font-size:10px;color:var(--t3);text-transform:uppercase;letter-spacing:1px;margin-top:3px}

            /* ─── FILTER TABS ─── */
            .ftabs-wrap{background:var(--bg2);border-bottom:1px solid var(--border);
              position:sticky;top:62px;z-index:99}
            .ftabs{display:flex;overflow-x:auto;scrollbar-width:none}
            .ftabs::-webkit-scrollbar{display:none}
            .ftab{font-family:var(--fd);font-size:12px;font-weight:700;letter-spacing:1.2px;
              text-transform:uppercase;color:var(--t3);padding:15px 18px;cursor:pointer;
              border:none;background:transparent;border-bottom:2px solid transparent;
              transition:var(--tr);white-space:nowrap}
            .ftab:hover{color:var(--t2);background:rgba(255,255,255,.02)}
            .ftab.active{color:var(--green);border-bottom-color:var(--green)}
            .live-dot{display:inline-block;width:6px;height:6px;background:var(--live);
              border-radius:50%;margin-right:5px;animation:pdot 1.4s ease-in-out infinite}
            @@keyframes pdot{0%,100%{opacity:1;transform:scale(1)}50%{opacity:.4;transform:scale(.7)}}
            .bcnt{background:var(--live);color:#fff;border-radius:9px;font-size:10px;
              padding:1px 6px;margin-left:5px;font-weight:700}

            /* ─── FEATURED CARD ─── */
            .feat-wrap{padding:30px 0 6px}
            .feat-lbl{font-family:var(--fd);font-size:11px;font-weight:700;letter-spacing:2px;
              text-transform:uppercase;color:var(--green);margin-bottom:12px;
              display:flex;align-items:center;gap:8px}
            .feat-lbl::before{content:'';display:inline-block;width:18px;height:2px;background:var(--green)}
            .feat-card{background:linear-gradient(135deg,#0d1d38 0%,#13213e 50%,#0d1f30 100%);
              border:1px solid rgba(41,121,255,.2);border-radius:var(--r3);padding:30px 36px;
              position:relative;overflow:hidden;transition:var(--tr);display:block;color:inherit}
            .feat-card:hover{border-color:rgba(41,121,255,.5);transform:translateY(-2px);
              box-shadow:0 12px 44px rgba(0,0,0,.6);color:inherit}
            .feat-card::after{content:'★ FEATURED MATCH';position:absolute;top:14px;right:18px;
              font-family:var(--fd);font-size:9px;font-weight:800;letter-spacing:2px;color:var(--gold);
              background:rgba(255,214,0,.09);border:1px solid rgba(255,214,0,.2);padding:3px 10px;border-radius:10px}
            .ft-team{display:flex;flex-direction:column;align-items:center;gap:12px}
            .ft-logo{width:70px;height:70px;border-radius:50%;background:var(--elevated);
              border:2px solid var(--border);display:flex;align-items:center;justify-content:center;
              font-family:var(--fd);font-size:20px;font-weight:900;overflow:hidden}
            .ft-logo img{width:100%;height:100%;object-fit:contain;padding:6px}
            .ft-name{font-family:var(--fd);font-size:18px;font-weight:800;text-align:center}
            .ft-type{font-size:10px;color:var(--t3);text-transform:uppercase;letter-spacing:1.5px;font-weight:600}
            .ft-sc-area{display:flex;flex-direction:column;align-items:center;justify-content:center;gap:10px}
            .ft-sc{font-family:var(--fd);font-size:clamp(48px,8vw,72px);font-weight:900;letter-spacing:-3px;
              line-height:1;background:linear-gradient(180deg,#fff 0%,#9ab5e0 100%);
              -webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text}
            .ft-stat{font-family:var(--fd);font-size:12px;font-weight:700;letter-spacing:1.5px;color:var(--t3)}
            .ft-meta{font-size:12px;color:var(--t2);text-align:center;margin-top:4px}

            /* ─── SECTION TITLE ─── */
            .sec-ttl{font-family:var(--fd);font-size:10px;font-weight:700;letter-spacing:2px;
              text-transform:uppercase;color:var(--t3);padding:14px 0 8px;
              border-top:1px solid var(--border);margin-top:8px;margin-bottom:4px}

            /* ═══════════════════════════════════════════════
               MATCH CARD  —  tam genişlik, tek satır düzeni
               ═══════════════════════════════════════════════ */
            .mc-wrap{margin-bottom:8px}

            /* Kart ana kutu: flex satırı, tam genişlik */
            .mc{
              width:100%;
              display:flex;
              align-items:center;
              background:var(--card);
              border:1px solid var(--border);
              border-radius:var(--r2);
              padding:0 18px;
              min-height:66px;
              overflow:hidden;
              transition:var(--tr);
              color:inherit;
            }
            .mc:hover{
              background:var(--card2);
              border-color:rgba(41,121,255,.3);
              transform:translateY(-1px);
              box-shadow:0 6px 24px rgba(0,0,0,.4);
              color:inherit;
            }
            .mc.live{border-color:rgba(255,23,68,.22);background:linear-gradient(90deg,var(--card),rgba(255,23,68,.03))}
            .mc.live:hover{border-color:rgba(255,23,68,.45)}
            .mc.lp{position:relative}
            .mc.lp::before{content:'';position:absolute;inset:-1px;border-radius:inherit;
              border:1px solid rgba(255,23,68,.35);animation:pbrd 2s ease-in-out infinite;pointer-events:none}
            @@keyframes pbrd{0%,100%{opacity:1;transform:scale(1)}50%{opacity:0;transform:scale(1.012)}}

            /* Saat / durum sütunu — sabit genişlik */
            .mc-time{
              flex-shrink:0;
              width:74px;
              display:flex;
              flex-direction:column;
              align-items:center;
              justify-content:center;
              gap:5px;
              padding:12px 0;
            }
            .mc-min{font-family:var(--fd);font-size:15px;font-weight:700;color:var(--t2)}
            .mc-min.lc{color:var(--live)}
            .mc-min.bc{color:var(--blue)}
            .mc-min.yc{color:var(--yellow)}
            .sbadge{font-family:var(--fd);font-size:9px;font-weight:700;letter-spacing:.8px;
              text-transform:uppercase;padding:2px 7px;border-radius:9px;white-space:nowrap}
            .sb-fin{background:rgba(143,163,200,.09);color:var(--t3)}
            .sb-live{background:rgba(255,23,68,.11);color:var(--live);border:1px solid rgba(255,23,68,.2);
              display:flex;align-items:center;gap:3px}
            .sb-up{background:rgba(41,121,255,.1);color:var(--blue)}
            .sb-ht{background:rgba(255,193,7,.1);color:var(--yellow)}

            /* Dikey çizgi */
            .dvv{width:1px;height:44px;background:var(--border);flex-shrink:0;margin:0 16px}

            /* Takımlar bloğu — kalan tüm alanı kaplar */
            .mc-teams{
              flex:1;           /* ← kritik: tüm boş alanı al */
              min-width:0;      /* flex overflow koruması */
              display:flex;
              flex-direction:column;
            }

            /* Tek takım satırı */
            .mc-tr{
              display:flex;
              align-items:center;
              gap:10px;
              padding:5px 0;
            }
            .mc-tr:first-child{border-bottom:1px solid rgba(255,255,255,.04)}

            .tl-sm{width:26px;height:26px;border-radius:50%;background:var(--elevated);
              border:1px solid var(--border);display:flex;align-items:center;justify-content:center;
              font-family:var(--fd);font-size:9px;font-weight:800;color:var(--t2);
              flex-shrink:0;overflow:hidden}
            .tl-sm img{width:100%;height:100%;object-fit:contain;padding:3px}

            /* Takım adı — esner, taşarsa kes */
            .tn{
              font-family:var(--fd);font-size:16px;font-weight:700;letter-spacing:.2px;
              flex:1;
              min-width:0;
              white-space:nowrap;overflow:hidden;text-overflow:ellipsis;
            }

            /* Skor — sağa yapışık */
            .ts{
              font-family:var(--fd);font-size:22px;font-weight:900;
              color:var(--t1);min-width:26px;text-align:right;flex-shrink:0;
            }
            .ts.win{color:var(--green)}
            .ts.dim{font-size:15px;color:var(--t3)}

            /* Detay butonu — kartın en sağı */
            .det-btn{
              flex-shrink:0;
              margin-left:16px;
              display:inline-flex;align-items:center;gap:5px;
              background:rgba(41,121,255,.08);border:1px solid rgba(41,121,255,.2);
              color:var(--blue);border-radius:var(--r1);padding:6px 13px;
              font-family:var(--fd);font-size:10px;font-weight:700;letter-spacing:1px;
              text-transform:uppercase;cursor:pointer;transition:var(--tr);white-space:nowrap;
            }
            .det-btn:hover{background:rgba(41,121,255,.18);color:var(--blue)}

            /* ─── FOOTER ─── */
            .ft{background:var(--bg2);border-top:1px solid var(--border);padding:44px 0 22px;margin-top:36px}
            .ft-brand{font-family:var(--fd);font-size:20px;font-weight:800;margin-bottom:8px}
            .ft-brand span{color:var(--green)}
            .ft-desc{font-size:12px;color:var(--t3);line-height:1.7;max-width:240px}
            .ft-h{font-family:var(--fd);font-size:11px;font-weight:700;letter-spacing:2px;
              text-transform:uppercase;color:var(--t2);margin-bottom:14px}
            .ft-ul{list-style:none;padding:0}.ft-ul li{margin-bottom:7px}
            .ft-ul a{color:var(--t3);font-size:12px;transition:var(--tr)}.ft-ul a:hover{color:var(--t1)}
            .si-row{display:flex;gap:7px;margin-top:14px}
            .si{width:34px;height:34px;background:var(--card);border:1px solid var(--border);
              border-radius:var(--r1);display:flex;align-items:center;justify-content:center;
              color:var(--t3);transition:var(--tr);font-size:13px}
            .si:hover{background:var(--elevated);color:var(--green);border-color:var(--green)}
            .ft-bot{border-top:1px solid var(--border);padding-top:18px;margin-top:32px;
              font-size:11px;color:var(--t3);display:flex;justify-content:space-between;flex-wrap:wrap;gap:6px}

            /* ─── RESPONSIVE ─── */
            @@media(max - width:600px){
              .tn{font-size:13px}
              .ts{font-size:18px}
              .mc-time{width:60px}
              .dvv{margin:0 10px}
              .det-btn{padding:5px 8px;font-size:9px}
              .det-btn span{display:none}
              .feat-card{padding:20px 14px}
              .ft-logo{width:52px;height:52px}
              .ft-name{font-size:14px}
              .ft-sc{font-size:44px}
              .lg-stats{display:none}
            }

            
/* ── PAGE HEADER ── */
.pg-head{background:linear-gradient(135deg,var(--bg2),var(--card));
  border-bottom:1px solid var(--border);padding:32px 0 24px;position:relative;overflow:hidden}
.pg-head::before{content:'';position:absolute;top:-40%;right:-5%;width:380px;height:380px;
  background:radial-gradient(circle,rgba(41,121,255,.05) 0%,transparent 70%);pointer-events:none}
.pg-badge{display:inline-flex;align-items:center;gap:7px;background:rgba(255,214,0,.09);
  border:1px solid rgba(255,214,0,.22);border-radius:20px;padding:4px 12px;
  font-family:var(--fd);font-size:11px;font-weight:700;letter-spacing:1px;color:var(--gold);
  text-transform:uppercase;margin-bottom:10px}
.pg-title{font-family:var(--fd);font-size:clamp(26px,5vw,42px);font-weight:900;letter-spacing:.5px;line-height:1}
.pg-sub{font-size:13px;color:var(--t2);margin-top:6px}

/* ── WEEK NAV ── */
.week-nav{display:flex;align-items:center;gap:10px;margin-top:16px}
.wn-btn{display:flex;align-items:center;gap:6px;background:var(--card);
  border:1px solid var(--border);border-radius:var(--r1);padding:8px 14px;
  font-family:var(--fd);font-size:12px;font-weight:700;letter-spacing:1px;
  text-transform:uppercase;color:var(--t2);cursor:pointer;transition:var(--tr)}
.wn-btn:hover{background:var(--elevated);color:var(--t1);border-color:var(--blue)}
.wn-cur{font-family:var(--fd);font-size:16px;font-weight:800;color:var(--t1);
  background:var(--card);border:1px solid var(--border);border-radius:var(--r1);
  padding:8px 20px;letter-spacing:.5px}

/* ── COUNTDOWN STRIP ── */
.countdown-strip{display:flex;align-items:center;justify-content:center;gap:6px;
  background:rgba(41,121,255,.06);border:1px solid rgba(41,121,255,.15);
  border-radius:var(--r2);padding:12px 20px;margin:24px 0 0;flex-wrap:wrap}
.cd-label{font-family:var(--fd);font-size:11px;font-weight:700;letter-spacing:1.5px;
  text-transform:uppercase;color:var(--t3)}
.cd-box{background:var(--elevated);border-radius:var(--r1);padding:6px 14px;text-align:center}
.cd-num{font-family:var(--fd);font-size:22px;font-weight:900;color:var(--blue);line-height:1}
.cd-unit{font-size:9px;color:var(--t3);text-transform:uppercase;letter-spacing:1px;margin-top:2px}
.cd-sep{font-family:var(--fd);font-size:22px;font-weight:900;color:var(--t3)}

/* ── CONTENT ── */
.content{padding:28px 0 56px}

/* ── DAY GROUP ── */
.day-group{margin-bottom:28px}
.day-header{display:flex;align-items:center;gap:12px;margin-bottom:12px}
.day-title{font-family:var(--fd);font-size:13px;font-weight:800;letter-spacing:2px;
  text-transform:uppercase;color:var(--t2)}
.day-date{font-family:var(--fd);font-size:12px;color:var(--t3);letter-spacing:1px}
.day-line{flex:1;height:1px;background:var(--border)}
.day-badge{font-family:var(--fd);font-size:10px;font-weight:700;letter-spacing:1px;
  text-transform:uppercase;padding:3px 10px;border-radius:8px;white-space:nowrap}
.db-today{background:rgba(0,230,118,.1);border:1px solid rgba(0,230,118,.2);color:var(--green)}
.db-tomorrow{background:rgba(41,121,255,.1);border:1px solid rgba(41,121,255,.2);color:var(--blue)}
.db-sun{background:rgba(255,214,0,.08);border:1px solid rgba(255,214,0,.18);color:var(--gold)}

/* ── FIXTURE CARD ── */
.fx-card{background:var(--card);border:1px solid var(--border);border-radius:var(--r2);
  padding:0;margin-bottom:8px;overflow:hidden;transition:var(--tr);position:relative}
.fx-card:hover{background:var(--card2);border-color:rgba(41,121,255,.3);
  transform:translateY(-1px);box-shadow:0 6px 24px rgba(0,0,0,.4)}
.fx-card.top-match{border-color:rgba(255,214,0,.22);
  background:linear-gradient(135deg,var(--card),rgba(255,214,0,.03))}
.fx-card.top-match:hover{border-color:rgba(255,214,0,.4)}
.fx-top-badge{position:absolute;top:0;left:0;right:0;height:2px;
  background:linear-gradient(90deg,var(--gold),transparent)}

.fx-inner{display:flex;align-items:center;padding:14px 18px;gap:0}

/* time column */
.fx-time-col{width:72px;flex-shrink:0;display:flex;flex-direction:column;align-items:center;gap:4px}
.fx-time{font-family:var(--fd);font-size:16px;font-weight:700;color:var(--t2)}
.fx-day-label{font-family:var(--fd);font-size:9px;font-weight:700;letter-spacing:.8px;
  text-transform:uppercase;color:var(--t3)}

.fx-divider{width:1px;height:44px;background:var(--border);margin:0 16px;flex-shrink:0}

/* teams area */
.fx-teams{flex:1;min-width:0;display:grid;grid-template-columns:1fr auto 1fr;
  align-items:center;gap:8px}
.fx-team-home{display:flex;align-items:center;gap:10px;justify-content:flex-end}
.fx-team-away{display:flex;align-items:center;gap:10px}
.fx-name{font-family:var(--fd);font-size:16px;font-weight:700;
  white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.fx-name.home{text-align:right}
.fx-logo{width:28px;height:28px;border-radius:50%;background:var(--elevated);
  border:1px solid var(--border);display:flex;align-items:center;justify-content:center;
  font-family:var(--fd);font-size:9px;font-weight:800;color:var(--t2);
  overflow:hidden;flex-shrink:0}
.fx-logo img{width:100%;height:100%;object-fit:contain;padding:3px}
.vs-block{display:flex;flex-direction:column;align-items:center;gap:2px;flex-shrink:0}
.vs-text{font-family:var(--fd);font-size:13px;font-weight:800;color:var(--t3)}
.vs-time-sm{font-family:var(--fd);font-size:10px;color:var(--t3)}

/* right side */
.fx-right{display:flex;flex-direction:column;align-items:flex-end;gap:6px;
  margin-left:14px;flex-shrink:0}
.fx-stadium{font-size:11px;color:var(--t3);text-align:right;max-width:140px;
  white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.notify-btn{display:inline-flex;align-items:center;gap:5px;
  background:rgba(41,121,255,.08);border:1px solid rgba(41,121,255,.2);
  color:var(--blue);border-radius:var(--r1);padding:5px 10px;
  font-family:var(--fd);font-size:10px;font-weight:700;letter-spacing:.8px;
  text-transform:uppercase;cursor:pointer;transition:var(--tr)}
.notify-btn:hover{background:rgba(41,121,255,.18);color:var(--blue)}
.notify-btn.active{background:rgba(0,230,118,.1);border-color:rgba(0,230,118,.3);color:var(--green)}

/* top match ribbon */
.top-match-tag{font-family:var(--fd);font-size:9px;font-weight:800;letter-spacing:1.5px;
  text-transform:uppercase;color:var(--gold);
  background:rgba(255,214,0,.08);border:1px solid rgba(255,214,0,.2);
  padding:2px 8px;border-radius:7px}

/* ── H2H MINI ── */
.h2h-strip{background:var(--bg2);border-top:1px solid var(--border);
  padding:8px 18px;display:flex;align-items:center;gap:10px;flex-wrap:wrap}
.h2h-label{font-family:var(--fd);font-size:9px;font-weight:700;letter-spacing:1.5px;
  text-transform:uppercase;color:var(--t3);white-space:nowrap}
.h2h-pills{display:flex;gap:4px}
.h2h-p{width:22px;height:22px;border-radius:5px;font-family:var(--fd);font-size:11px;
  font-weight:800;display:flex;align-items:center;justify-content:center}
.h2h-w{background:rgba(0,230,118,.15);color:var(--green)}
.h2h-d{background:rgba(123,150,196,.12);color:var(--t2)}
.h2h-l{background:rgba(255,23,68,.12);color:var(--live)}
.h2h-avg{font-family:var(--fd);font-size:11px;color:var(--t3);margin-left:auto}

/* ── KEY PLAYERS STRIP ── */
.kp-strip{background:var(--bg2);border-top:1px solid var(--border);
  padding:8px 18px;display:flex;align-items:center;gap:12px;flex-wrap:wrap}
.kp-label{font-family:var(--fd);font-size:9px;font-weight:700;letter-spacing:1.5px;
  text-transform:uppercase;color:var(--t3);white-space:nowrap}
.kp-tag{display:inline-flex;align-items:center;gap:5px;background:var(--elevated);
  border:1px solid var(--border);border-radius:7px;padding:4px 9px;
  font-family:var(--fd);font-size:11px;font-weight:700;color:var(--t2)}
.kp-tag i{font-size:10px;color:var(--green)}

/* ── WEEK SUMMARY CARD ── */
.week-summary{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;margin-bottom:24px}
.ws-card{background:var(--card);border:1px solid var(--border);border-radius:var(--r2);
  padding:16px;text-align:center}
.ws-num{font-family:var(--fd);font-size:26px;font-weight:900;line-height:1}
.ws-lbl{font-size:11px;color:var(--t3);text-transform:uppercase;letter-spacing:1px;margin-top:4px;font-weight:600}


/* ── RESPONSIVE ── */
@@media(max-width:768px){
  .fx-right .fx-stadium{display:none}
  .week-summary{grid-template-columns:repeat(2,1fr)}
  .kp-strip,.h2h-strip{display:none}
  .fx-name{font-size:13px}
  .fx-time{font-size:14px}
}
@@media(max-width:500px){
  .fx-teams{gap:4px}
  .fx-name{font-size:12px}
  .fx-logo{width:22px;height:22px}
  .week-summary{grid-template-columns:repeat(2,1fr);gap:8px}
  .ws-num{font-size:20px}
  .notify-btn span{display:none}
  .fx-right{margin-left:8px}
}

/* ── LEGEND BADGES ── */
.legend{display:flex;align-items:center;gap:6px;flex-wrap:wrap}
.leg-item{display:flex;align-items:center;gap:6px;font-size:11px;color:var(--t2);
  background:var(--card);border:1px solid var(--border);padding:5px 10px;border-radius:7px}
.leg-dot{width:8px;height:8px;border-radius:2px;flex-shrink:0}

/* ── TABLE CONTAINER ── */
.tbl-wrap{padding:28px 0 56px}

/* ── ZONE LABELS ── */
.zone-lbl{font-family:var(--fd);font-size:10px;font-weight:700;letter-spacing:2px;
  text-transform:uppercase;color:var(--t3);padding:12px 0 6px;
  border-top:1px solid var(--border);margin-top:4px}

/* ── STANDINGS TABLE ── */
.std-table{width:100%;border-collapse:separate;border-spacing:0 4px}
.std-table thead th{font-family:var(--fd);font-size:10px;font-weight:700;letter-spacing:1.5px;
  text-transform:uppercase;color:var(--t3);padding:6px 10px;text-align:center;border:none}
.std-table thead th.team-col{text-align:left;padding-left:14px}
.std-row{background:var(--card);transition:var(--tr);cursor:pointer}
.std-row:hover{background:var(--card2);transform:translateX(3px)}
.std-row td{padding:11px 10px;text-align:center;border:none;vertical-align:middle}
.std-row td:first-child{border-radius:var(--r1) 0 0 var(--r1);padding-left:0}
.std-row td:last-child{border-radius:0 var(--r1) var(--r1) 0}

/* position marker strip */
.pos-strip{width:4px;height:42px;border-radius:2px 0 0 2px;flex-shrink:0}
.pos-cell{display:flex;align-items:center;gap:0;padding:0}
.pos-num{font-family:var(--fd);font-size:16px;font-weight:800;color:var(--t2);
  width:38px;text-align:center}
.pos-num.top1{color:var(--gold)}
.pos-num.top4{color:var(--green)}
.pos-num.euro{color:var(--blue)}
.pos-num.rel{color:var(--live)}

/* team cell */
.team-cell{display:flex;align-items:center;gap:10px;text-align:left;min-width:160px}
.t-logo{width:28px;height:28px;border-radius:50%;background:var(--elevated);
  border:1px solid var(--border);display:flex;align-items:center;justify-content:center;
  font-family:var(--fd);font-size:9px;font-weight:800;color:var(--t2);
  overflow:hidden;flex-shrink:0}
.t-logo img{width:100%;height:100%;object-fit:contain;padding:3px}
.t-name{font-family:var(--fd);font-size:15px;font-weight:700}
.t-name .t-short{display:none;font-size:14px}

/* stat cells */
.std-row .s-mp{font-family:var(--fd);font-size:14px;font-weight:600;color:var(--t2)}
.std-row .s-w{font-family:var(--fd);font-size:14px;font-weight:700;color:var(--green)}
.std-row .s-d{font-family:var(--fd);font-size:14px;font-weight:700;color:var(--t2)}
.std-row .s-l{font-family:var(--fd);font-size:14px;font-weight:700;color:var(--live)}
.std-row .s-gf{font-family:var(--fd);font-size:14px;font-weight:600;color:var(--t1)}
.std-row .s-ga{font-family:var(--fd);font-size:14px;font-weight:600;color:var(--t1)}
.std-row .s-gd{font-family:var(--fd);font-size:14px;font-weight:700}
.s-gd.pos{color:var(--green)}.s-gd.neg{color:var(--live)}.s-gd.zero{color:var(--t3)}
.s-pts{font-family:var(--fd);font-size:18px;font-weight:900;color:var(--t1)}
.pts-top{color:var(--gold) !important}

/* form pills */
.form-row{display:flex;gap:3px;justify-content:center}
.fp{width:18px;height:18px;border-radius:4px;font-family:var(--fd);font-size:10px;
  font-weight:800;display:flex;align-items:center;justify-content:center;line-height:1}
.fp-w{background:rgba(0,230,118,.18);color:var(--green)}
.fp-d{background:rgba(123,150,196,.12);color:var(--t2)}
.fp-l{background:rgba(255,23,68,.14);color:var(--live)}

/* position color bar on left of row */
.cl-champ{background:rgba(255,214,0,.7)}
.cl-ucl{background:var(--green)}
.cl-uel{background:var(--blue)}
.cl-uecl{background:#00bcd4}
.cl-rel{background:var(--live)}
.cl-none{background:transparent}

/* ── TOP STATS CARDS ── */
.top-stats{display:grid;grid-template-columns:repeat(4,1fr);gap:14px;margin-bottom:24px}
.ts-card{background:var(--card);border:1px solid var(--border);border-radius:var(--r2);
  padding:18px;display:flex;flex-direction:column;gap:4px}
.ts-label{font-family:var(--fd);font-size:10px;font-weight:700;letter-spacing:1.5px;
  text-transform:uppercase;color:var(--t3)}
.ts-val{font-family:var(--fd);font-size:28px;font-weight:900;line-height:1}
.ts-team{font-size:12px;color:var(--t2);margin-top:2px}


/* ── RESPONSIVE ── */
@@media(max-width:900px){
  .hide-md{display:none!important}
  .t-name span.t-full{display:none}
  .t-name .t-short{display:inline}
  .top-stats{grid-template-columns:repeat(2,1fr)}
}
@@media(max-width:600px){
  .hide-sm{display:none!important}
  .top-stats{grid-template-columns:repeat(2,1fr);gap:8px}
  .ts-val{font-size:22px}
  .std-row .s-pts{font-size:15px}
  .pos-num{width:28px;font-size:14px}
  .team-cell{min-width:120px;gap:7px}
  .t-logo{width:22px;height:22px}
  .t-name .t-short{font-size:12px}
  .fp{width:15px;height:15px;font-size:9px}
}


/* ── WRAP ── */
.wrap{max-width:1120px;margin:0 auto;padding:0 20px}

/* ── HERO ── */
.hero{background:linear-gradient(180deg,#0b1830 0%,var(--bg) 100%);
  border-bottom:1px solid var(--border);padding:36px 0 28px;position:relative;overflow:hidden}
.hero::before{content:'';position:absolute;inset:0;
  background:radial-gradient(ellipse at 20% 50%,rgba(0,230,118,.05) 0%,transparent 60%),
  radial-gradient(ellipse at 80% 50%,rgba(41,121,255,.05) 0%,transparent 60%);pointer-events:none}
.hero-badges{display:flex;align-items:center;justify-content:center;gap:8px;
  margin-bottom:26px;flex-wrap:wrap}
.hbadge{font-family:var(--fd);font-size:10px;font-weight:700;letter-spacing:1.5px;
  text-transform:uppercase;padding:4px 12px;border-radius:20px}
.hb-gold{background:rgba(255,214,0,.09);border:1px solid rgba(255,214,0,.2);color:var(--gold)}
.hb-gray{background:rgba(143,163,200,.08);color:var(--t3)}
.hb-green{background:rgba(0,230,118,.08);border:1px solid rgba(0,230,118,.18);color:var(--green)}
.hero-grid{display:grid;grid-template-columns:1fr auto 1fr;gap:20px;align-items:center}
.h-team{display:flex;flex-direction:column;align-items:center;gap:12px}
.h-logo{width:86px;height:86px;border-radius:50%;background:var(--card);
  border:2px solid var(--border);display:flex;align-items:center;justify-content:center;
  font-family:var(--fd);font-size:24px;font-weight:900;overflow:hidden}
.h-logo img{width:100%;height:100%;object-fit:contain;padding:8px}
.h-name{font-family:var(--fd);font-size:clamp(18px,3vw,26px);font-weight:900;
  letter-spacing:.3px;text-align:center}
.h-type{font-size:10px;color:var(--t3);text-transform:uppercase;letter-spacing:1.5px;font-weight:600}
.h-score-c{display:flex;flex-direction:column;align-items:center;gap:10px}
.h-sc{font-family:var(--fd);font-size:clamp(54px,10vw,88px);font-weight:900;
  letter-spacing:-4px;line-height:1;
  background:linear-gradient(180deg,#fff 0%,#8fa3c8 100%);
  -webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text}
.h-ht{font-family:var(--fd);font-size:12px;color:var(--t2);background:var(--card);
  padding:4px 14px;border-radius:11px;border:1px solid var(--border)}
.h-ft{font-family:var(--fd);font-size:12px;font-weight:700;letter-spacing:1.5px;
  text-transform:uppercase;color:var(--t3)}
.info-strip{display:flex;align-items:center;justify-content:center;gap:22px;
  margin-top:22px;padding-top:18px;border-top:1px solid var(--border);flex-wrap:wrap}
.istrip{display:flex;align-items:center;gap:6px;font-size:12px;color:var(--t2)}
.istrip i{color:var(--t3);font-size:13px}

/* ── CONTENT ── */
.content{padding:28px 0 56px}
.dc{background:var(--card);border:1px solid var(--border);border-radius:var(--r3);
  padding:22px;margin-bottom:18px}
.dc-title{font-family:var(--fd);font-size:11px;font-weight:700;letter-spacing:2px;
  text-transform:uppercase;color:var(--t3);margin-bottom:18px;
  display:flex;align-items:center;gap:10px}
.dc-title::after{content:'';flex:1;height:1px;background:var(--border)}

/* ── TIMELINE ── */
.tl-wrap{position:relative}
.tl-line{position:absolute;left:50%;top:0;bottom:0;width:1px;
  background:var(--border);transform:translateX(-50%)}
.tl-ev{display:grid;grid-template-columns:1fr 58px 1fr;gap:10px;
  align-items:center;margin-bottom:10px;
  animation:fadeUp .4s ease both}
@@keyframes fadeUp{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:none}}
.tl-ev:nth-child(1){animation-delay:.05s}.tl-ev:nth-child(2){animation-delay:.1s}
.tl-ev:nth-child(3){animation-delay:.15s}.tl-ev:nth-child(4){animation-delay:.2s}
.tl-ev:nth-child(5){animation-delay:.25s}.tl-ev:nth-child(6){animation-delay:.3s}
.tl-ev:nth-child(7){animation-delay:.35s}.tl-ev:nth-child(8){animation-delay:.4s}
.tl-ev:nth-child(9){animation-delay:.45s}.tl-ev:nth-child(10){animation-delay:.5s}
.tl-ev:nth-child(11){animation-delay:.55s}
.tl-home{display:flex;justify-content:flex-end}
.tl-away{display:flex;justify-content:flex-start}
.tl-min-c{display:flex;align-items:center;justify-content:center}
.min-b{background:var(--elevated);border:1px solid var(--border);border-radius:11px;
  padding:3px 8px;font-family:var(--fd);font-size:11px;font-weight:700;
  color:var(--t2);white-space:nowrap;position:relative;z-index:1}
.chip{display:flex;align-items:center;gap:7px;background:var(--elevated);
  border:1px solid var(--border);border-radius:var(--r1);padding:8px 11px;max-width:210px}
.chip.home{flex-direction:row-reverse;text-align:right}
.chip.goal-ev{border-color:rgba(0,230,118,.25);background:rgba(0,230,118,.06)}
.chip.yel-ev{border-color:rgba(255,193,7,.25);background:rgba(255,193,7,.06)}
.chip.red-ev{border-color:rgba(244,67,54,.25);background:rgba(244,67,54,.06)}
.chip.sub-ev{border-color:rgba(41,121,255,.2);background:rgba(41,121,255,.05)}
.ev-ico{width:26px;height:26px;border-radius:6px;display:flex;align-items:center;
  justify-content:center;font-size:13px;flex-shrink:0}
.ei-goal{background:rgba(0,230,118,.15);color:var(--green)}
.ei-yel{background:rgba(255,193,7,.15);color:var(--yellow)}
.ei-red{background:rgba(244,67,54,.15);color:var(--red)}
.ei-sub{background:rgba(41,121,255,.12);color:var(--blue)}
.ev-pl{font-family:var(--fd);font-size:14px;font-weight:700;color:var(--t1)}
.ev-dt{font-size:10px;color:var(--t3)}

/* ── GOALS / CARDS ── */
.split2{display:grid;grid-template-columns:1fr 1fr;gap:14px}
.box2{padding:14px;background:var(--bg2);border-radius:var(--r2);border:1px solid var(--border)}
.box2-title{font-family:var(--fd);font-size:10px;font-weight:700;letter-spacing:1.5px;
  text-transform:uppercase;color:var(--t3);margin-bottom:10px}
.gl{display:flex;align-items:center;gap:9px;padding:6px 0;
  border-bottom:1px solid rgba(255,255,255,.04)}
.gl:last-child{border-bottom:none}
.gl-ico{width:20px;height:20px;background:rgba(0,230,118,.12);border-radius:50%;
  display:flex;align-items:center;justify-content:center;font-size:10px;
  color:var(--green);flex-shrink:0}
.gl-pl{font-family:var(--fd);font-size:14px;font-weight:700;flex:1}
.gl-min{font-family:var(--fd);font-size:11px;font-weight:700;color:var(--t3);
  background:var(--elevated);padding:2px 7px;border-radius:7px}
.ycard{width:12px;height:16px;background:var(--yellow);border-radius:2px;
  flex-shrink:0;box-shadow:0 2px 5px rgba(255,193,7,.3)}
.rcard{width:12px;height:16px;background:var(--red);border-radius:2px;
  flex-shrink:0;box-shadow:0 2px 5px rgba(244,67,54,.3)}

/* ── SUBSTITUTIONS ── */
.sub-r{display:flex;align-items:center;gap:11px;padding:9px 0;
  border-bottom:1px solid rgba(255,255,255,.04)}
.sub-r:last-child{border-bottom:none}
.sub-min{font-family:var(--fd);font-size:12px;font-weight:700;color:var(--t3);
  background:var(--elevated);padding:3px 9px;border-radius:9px;
  width:46px;text-align:center;flex-shrink:0}
.sub-in{font-family:var(--fd);font-size:13px;font-weight:700;color:var(--green)}
.sub-out{font-family:var(--fd);font-size:13px;font-weight:700;color:var(--live)}
.sub-arr{color:var(--t3);font-size:15px}
.sub-lbl{font-family:var(--fd);font-size:10px;font-weight:700;letter-spacing:1px;
  text-transform:uppercase;color:var(--t3);margin:14px 0 6px;
  padding-top:10px;border-top:1px solid var(--border)}
.sub-lbl:first-child{margin-top:0;padding-top:0;border-top:none}

/* ── STATS ── */
.stat-r{display:grid;grid-template-columns:1fr auto 1fr;gap:10px;
  align-items:center;margin-bottom:12px}
.sv-h{font-family:var(--fd);font-size:17px;font-weight:800;text-align:right}
.sv-a{font-family:var(--fd);font-size:17px;font-weight:800;text-align:left}
.sl{font-size:10px;font-weight:600;letter-spacing:1px;text-transform:uppercase;
  color:var(--t3);text-align:center;white-space:nowrap}
.bar-r{display:grid;grid-template-columns:1fr 20px 1fr;gap:7px;
  align-items:center;margin-bottom:12px}
.bh{height:3px;background:var(--elevated);border-radius:2px;
  overflow:hidden;display:flex;justify-content:flex-end}
.bh .f{height:100%;background:linear-gradient(90deg,var(--blue),#6aabff);
  border-radius:2px;transition:width 1.1s ease}
.ba{height:3px;background:var(--elevated);border-radius:2px;overflow:hidden}
.ba .f{height:100%;background:linear-gradient(90deg,#ff6b6b,var(--live));
  border-radius:2px;transition:width 1.1s ease}

/* ── MATCH INFO BOX ── */
.mi-row{display:flex;justify-content:space-between;align-items:center;
  padding:9px 0;border-bottom:1px solid var(--border);font-size:13px}
.mi-row:last-child{border-bottom:none}
.mi-key{color:var(--t3)}.mi-val{font-family:var(--fd);font-size:14px;font-weight:700;text-align:right}

/* ── SCORE PILLS ── */
.sc-pills{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin-bottom:4px}
.sc-pill{background:var(--bg2);border-radius:var(--r2);padding:11px;
  text-align:center;border:1px solid var(--border)}
.sp-lbl{font-family:var(--fd);font-size:10px;color:var(--t3);
  text-transform:uppercase;letter-spacing:1px;margin-bottom:3px}
.sp-val{font-family:var(--fd);font-size:22px;font-weight:900}

/* ── BACK BTN ── */
.back-btn{display:inline-flex;align-items:center;gap:7px;background:var(--card);
  border:1px solid var(--border);border-radius:var(--r2);color:var(--t2);
  padding:10px 18px;font-family:var(--fd);font-size:12px;font-weight:700;
  letter-spacing:1px;text-transform:uppercase;transition:var(--tr);margin-bottom:22px}
.back-btn:hover{background:var(--elevated);border-color:var(--blue);color:var(--t1)}


/* ── RESPONSIVE ── */
@@media(max-width:768px){
  .hero-grid{gap:10px}
  .h-logo{width:60px;height:60px}
  .h-name{font-size:14px}
  .h-sc{font-size:52px;letter-spacing:-2px}
  .tl-ev{grid-template-columns:1fr 46px 1fr;gap:5px}
  .chip{padding:6px 8px;max-width:140px}
  .ev-pl{font-size:12px}.ev-dt{display:none}
  .ev-ico{width:22px;height:22px;font-size:11px}
  .split2{grid-template-columns:1fr}
  .info-strip{gap:12px}.istrip{font-size:11px}
  .sc-pills{grid-template-columns:repeat(3,1fr)}
}
@@media(max-width:480px){
  .h-sc{font-size:42px}
  .h-logo{width:50px;height:50px}
  .h-name{font-size:12px}
  .info-strip{gap:8px}
}

/* Sezon ve Hafta Seçim Alanı Stilleri */
.match-filter-box {
  background: rgba(18, 24, 38, 0.7);
  border: 1px solid rgba(255, 255, 255, 0.08);
  border-radius: 12px;
  padding: 16px 20px;
  backdrop-filter: blur(12px);
  box-shadow: 0 8px 32px rgba(0, 0, 0, 0.3);
}

.mf-header {
  display: flex;
  align-items: center;
  gap: 8px;
  font-size: 0.75rem;
  font-weight: 600;
  color: #94a3b8;
  letter-spacing: 0.8px;
  margin-bottom: 12px;
  text-transform: uppercase;
}

.mf-icon {
  color: #38bdf8; /* Sitenizdeki mavi tonuna uyumlu */
  font-size: 0.9rem;
}

.mf-selectors-grid {
  display: flex;
  gap: 12px;
}

.mf-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.mf-lbl {
