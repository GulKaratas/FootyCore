
@model MatchDetailsViewModel
@{
    ViewData["Title"] = "MatchDetails";
    Layout = "~/Views/Default/_IndexLayout.cshtml";

    var culture = new CultureInfo("tr-TR");
    var match = Model.Match;
    var stat = Model.Statistic;
    var events = Model.Details ?? new List<ResultMatchDetailDto>();
    var goals = Model.Goals ?? new List<ResultMatchDetailDto>();
    var cards = Model.Cards ?? new List<ResultMatchDetailDto>();
    var subs = Model.Substitutions ?? new List<ResultMatchDetailDto>();

    var homeGoals = goals.Where(x => match != null && x.TeamId == match.HomeTeamId).ToList();
    var awayGoals = goals.Where(x => match != null && x.TeamId != match.HomeTeamId).ToList();
    var homeCards = cards.Where(x => match != null && x.TeamId == match.HomeTeamId).ToList();
    var awayCards = cards.Where(x => match != null && x.TeamId != match.HomeTeamId).ToList();
    var homeSubs = subs.Where(x => match != null && x.TeamId == match.HomeTeamId).ToList();
    var awaySubs = subs.Where(x => match != null && x.TeamId != match.HomeTeamId).ToList();

    string Pair(int? home, int? away) => home.HasValue && away.HasValue ? $"{home}–{away}" : "—";
    int Share(int home, int away)
    {
        var total = home + away;
        return total == 0 ? 0 : home * 100 / total;
    }
    string InName(string description)
    {
        var parts = (description ?? "").Split('/');
        return parts[0].Trim();
    }
    string OutName(string description)
    {
        var parts = (description ?? "").Split('/');
        return parts.Length > 1 ? parts[1].Trim() : "";
    }

    var scoreText = match == null ? "—" : Pair(match.HomeScore, match.AwayScore);
    var htText = stat == null ? "—" : $"{stat.HomeFirstHalfGoals}–{stat.AwayFirstHalfGoals}";
    var secondText = stat == null ? "—" : $"{stat.HomeSecondHalfGoals}–{stat.AwaySecondHalfGoals}";
    var homeShots = stat?.HomeShots ?? 0;
    var awayShots = stat?.AwayShots ?? 0;
    var homeOnTarget = stat?.HomeShotsOnTarget ?? 0;
    var awayOnTarget = stat?.AwayShotsOnTarget ?? 0;
    var homePossession = stat?.HomePossession ?? 0;
    var awayPossession = stat?.AwayPossession ?? 0;
    var shotShare = Share(homeShots, awayShots);
    var targetShare = Share(homeOnTarget, awayOnTarget);
    var homeYellow = homeCards.Count(x => x.ActionType == "Sarı Kart");
    var awayYellow = awayCards.Count(x => x.ActionType == "Sarı Kart");
    var homeRed = homeCards.Count(x => x.ActionType == "Kırmızı Kart");
    var awayRed = awayCards.Count(x => x.ActionType == "Kırmızı Kart");
    var printedHalf = false;
}

<section class="hero">
  <div class="wrap">
    @if (match == null || match.MatchId == 0)
    {
        <h1 class="pg-title">Maç bulunamadı</h1>
    }
    else
    {
        <div class="hero-badges">
          <span class="hbadge hb-gold"><i class="bi bi-trophy-fill me-1"></i>@match.LeagueName · Hafta @match.Week</span>
          <span class="hbadge hb-gray"><i class="bi bi-check2-circle me-1"></i>@match.StatusName</span>
        </div>
        <div class="hero-grid">
          <div class="h-team">
            <div class="h-logo">
              <img src="@match.HomeLogoUrl" alt="@match.HomeTeamName" onerror="this.parentNode.textContent='@match.HomeTeamName'" />
            </div>
            <div class="h-name">@match.HomeTeamName</div>
            <div class="h-type">Ev Sahibi</div>
          </div>
          <div class="h-score-c">
            <div class="h-sc">@scoreText</div>
            <div class="h-ht"><i class="bi bi-hourglass-split me-1"></i>İY: @htText</div>
            <div class="h-ft">@match.StatusName</div>
          </div>
          <div class="h-team">
            <div class="h-logo">
              <img src="@match.AwayLogoUrl" alt="@match.AwayTeamName" onerror="this.parentNode.textContent='@match.AwayTeamName'" />
            </div>
            <div class="h-name">@match.AwayTeamName</div>
            <div class="h-type">Deplasman</div>
          </div>
        </div>
        <div class="info-strip">
          <div class="istrip"><i class="bi bi-geo-alt-fill"></i><span>@match.StadiumName, @match.City</span></div>
          <div class="istrip"><i class="bi bi-calendar3"></i><span>@match.MatchDate.ToString("dd MMMM yyyy", culture)</span></div>
          <div class="istrip"><i class="bi bi-clock"></i><span>@match.MatchDate.ToString("HH:mm", culture)</span></div>
        </div>
    }
  </div>
</section>

<div class="content">
<div class="wrap">
  <a asp-controller="Match" asp-action="MatchList" class="back-btn"><i class="bi bi-arrow-left"></i> Maç Listesine Dön</a>

  @if (match != null && match.MatchId != 0)
  {
  <div class="row g-4">
    <div class="col-lg-7">
      <div class="dc">
        <div class="dc-title"><i class="bi bi-activity me-2" style="color:var(--green)"></i>Maç Olayları</div>
        <div class="tl-wrap">
          <div class="tl-line"></div>
          @foreach (var item in events)
          {
              if (!printedHalf && item.Minute > 45)
              {
                  printedHalf = true;
                  <div class="tl-ev">
                    <div class="tl-home"></div>
                    <div class="tl-min-c"><div class="min-b" style="background:rgba(255,193,7,.09);border-color:rgba(255,193,7,.22);color:var(--yellow)">İY</div></div>
                    <div class="tl-away"></div>
                  </div>
              }

              var isHome = item.TeamId == match.HomeTeamId;
              var chipClass = item.ActionType == "Gol" ? "goal-ev" : item.ActionType == "Sarı Kart" ? "yel-ev" : item.ActionType == "Kırmızı Kart" ? "red-ev" : "sub-ev";
              var iconClass = item.ActionType == "Gol" ? "ei-goal" : item.ActionType == "Sarı Kart" ? "ei-yel" : item.ActionType == "Kırmızı Kart" ? "ei-red" : "ei-sub";
              var icon = item.ActionType == "Değişiklik" ? "bi-arrow-left-right" : item.ActionType == "Gol" ? "bi-circle-fill" : "bi-square-fill";
              <div class="tl-ev">
                <div class="tl-home">
                  @if (isHome)
                  {
                      <div class="chip home @chipClass">
                        <div class="ev-ico @iconClass"><i class="bi @icon" style="font-size:10px"></i></div>
                        <div><div class="ev-pl">@item.Description</div><div class="ev-dt">@item.ActionType</div></div>
                      </div>
                  }
                </div>
                <div class="tl-min-c"><div class="min-b">@item.Minute'</div></div>
                <div class="tl-away">
                  @if (!isHome)
                  {
                      <div class="chip away @chipClass">
                        <div class="ev-ico @iconClass"><i class="bi @icon" style="font-size:10px"></i></div>
                        <div><div class="ev-pl">@item.Description</div><div class="ev-dt">@item.ActionType</div></div>
                      </div>
                  }
                </div>
              </div>
          }
          @if (match.StatusName != null && match.StatusName.Contains("Bitti"))
          {
              <div class="tl-ev">
                <div class="tl-home"></div>
                <div class="tl-min-c"><div class="min-b" style="background:rgba(143,163,200,.08);border-color:rgba(143,163,200,.18);color:var(--t2)">MS</div></div>
                <div class="tl-away"></div>
              </div>
          }
        </div>
      </div>

      <div class="dc">
        <div class="dc-title"><i class="bi bi-circle-fill me-2" style="color:var(--green);font-size:9px"></i>Goller</div>
        <div class="split2">
          <div class="box2">
            <div class="box2-title">⚽ @match.HomeTeamName</div>
            @foreach (var goal in homeGoals)
            {
                <div class="gl"><div class="gl-ico">⚽</div><div class="gl-pl">@goal.Description</div><div class="gl-min">@goal.Minute'</div></div>
            }
          </div>
          <div class="box2">
            <div class="box2-title">⚽ @match.AwayTeamName</div>
            @foreach (var goal in awayGoals)
            {
                <div class="gl"><div class="gl-ico">⚽</div><div class="gl-pl">@goal.Description</div><div class="gl-min">@goal.Minute'</div></div>
            }
          </div>
        </div>
      </div>

      <div class="dc">
        <div class="dc-title"><i class="bi bi-square-fill me-2" style="color:var(--yellow);font-size:10px"></i>Kartlar</div>
        <div class="split2">
          <div class="box2">
            <div class="box2-title">@match.HomeTeamName</div>
            @foreach (var card in homeCards)
            {
                <div class="gl">
                  <div class="@(card.ActionType == "Kırmızı Kart" ? "rcard" : "ycard")"></div>
                  <div class="gl-pl">@card.Description</div>
                  <div class="gl-min">@card.Minute'</div>
                </div>
            }
          </div>
          <div class="box2">
            <div class="box2-title">@match.AwayTeamName</div>
            @foreach (var card in awayCards)
            {
                <div class="gl">
                  <div class="@(card.ActionType == "Kırmızı Kart" ? "rcard" : "ycard")"></div>
                  <div class="gl-pl">@card.Description</div>
                  <div class="gl-min">@card.Minute'</div>
                </div>
            }
          </div>
        </div>
      </div>

      <div class="dc">
        <div class="dc-title"><i class="bi bi-arrow-left-right me-2" style="color:var(--blue)"></i>Oyuncu Değişiklikleri</div>
        <div class="sub-lbl">@match.HomeTeamName</div>
        @foreach (var sub in homeSubs)
        {
            <div class="sub-r">
              <div class="sub-min">@sub.Minute'</div>
              <div class="sub-in">↑ @InName(sub.Description)</div>
              <div class="sub-arr">⇄</div>
              <div class="sub-out">↓ @OutName(sub.Description)</div>
            </div>
        }
        <div class="sub-lbl">@match.AwayTeamName</div>
        @foreach (var sub in awaySubs)
        {
            <div class="sub-r">
              <div class="sub-min">@sub.Minute'</div>
              <div class="sub-in">↑ @InName(sub.Description)</div>
              <div class="sub-arr">⇄</div>
              <div class="sub-out">↓ @OutName(sub.Description)</div>
            </div>
        }
      </div>
    </div>

    <div class="col-lg-5">
      <div class="dc">
        <div class="dc-title"><i class="bi bi-bar-chart-fill me-2" style="color:var(--blue)"></i>Maç Özeti</div>
        <div class="sc-pills">
          <div class="sc-pill"><div class="sp-lbl">İlk Yarı</div><div class="sp-val">@htText</div></div>
          <div class="sc-pill"><div class="sp-lbl">İkinci Yarı</div><div class="sp-val">@secondText</div></div>
          <div class="sc-pill"><div class="sp-lbl">Sonuç</div><div class="sp-val" style="color:var(--green)">@scoreText</div></div>
        </div>
      </div>

      <div class="dc">
        <div class="dc-title"><i class="bi bi-graph-up me-2" style="color:var(--green)"></i>İstatistikler</div>
        <div class="stat-r"><div class="sv-h">@homePossession%</div><div class="sl">Topa Sahip Olma</div><div class="sv-a">@awayPossession%</div></div>
        <div class="bar-r"><div class="bh"><div class="f" style="width:@homePossession%"></div></div><div></div><div class="ba"><div class="f" style="width:@awayPossession%"></div></div></div>

        <div class="stat-r"><div class="sv-h">@homeShots</div><div class="sl">Şut</div><div class="sv-a">@awayShots</div></div>
        <div class="bar-r"><div class="bh"><div class="f" style="width:@shotShare%"></div></div><div></div><div class="ba"><div class="f" style="width:@(100 - shotShare)%"></div></div></div>

        <div class="stat-r"><div class="sv-h">@homeOnTarget</div><div class="sl">İsabetli Şut</div><div class="sv-a">@awayOnTarget</div></div>
        <div class="bar-r" style="margin-bottom:14px"><div class="bh"><div class="f" style="width:@targetShare%"></div></div><div></div><div class="ba"><div class="f" style="width:@(100 - targetShare)%"></div></div></div>

        <div class="stat-r" style="margin-bottom:0">
          <div class="sv-h" style="color:var(--yellow)">@homeYellow</div>
          <div class="sl">Sarı Kart</div>
          <div class="sv-a" style="color:var(--yellow)">@awayYellow</div>
        </div>
        <div class="stat-r" style="margin-bottom:0;margin-top:8px">
          <div class="sv-h" style="color:var(--red)">@homeRed</div>
          <div class="sl">Kırmızı Kart</div>
          <div class="sv-a" style="color:var(--t3)">@awayRed</div>
        </div>

        <div style="display:flex;justify-content:space-between;margin-top:18px;padding-top:14px;border-top:1px solid var(--border)">
          <div style="display:flex;align-items:center;gap:7px">
            <div style="width:9px;height:9px;border-radius:50%;background:var(--blue)"></div>
            <span style="font-family:var(--fd);font-size:12px;font-weight:700;color:var(--t2)">@match.HomeTeamName</span>
          </div>
          <div style="display:flex;align-items:center;gap:7px">
            <span style="font-family:var(--fd);font-size:12px;font-weight:700;color:var(--t2)">@match.AwayTeamName</span>
            <div style="width:9px;height:9px;border-radius:50%;background:var(--live)"></div>
          </div>
        </div>
      </div>

      <div class="dc">
        <div class="dc-title"><i class="bi bi-info-circle me-2" style="color:var(--t3)"></i>Maç Bilgileri</div>
        <div class="mi-row"><span class="mi-key">Lig</span><span class="mi-val" style="color:var(--gold)">@match.LeagueName</span></div>
        <div class="mi-row"><span class="mi-key">Sezon</span><span class="mi-val">@match.SeasonName</span></div>
        <div class="mi-row"><span class="mi-key">Hafta</span><span class="mi-val">Hafta @match.Week</span></div>
        <div class="mi-row"><span class="mi-key">Stadyum</span><span class="mi-val">@match.StadiumName</span></div>
        <div class="mi-row"><span class="mi-key">Şehir</span><span class="mi-val">@match.City</span></div>
        <div class="mi-row"><span class="mi-key">Tarih</span><span class="mi-val">@match.MatchDate.ToString("dd MMMM yyyy", culture)</span></div>
        <div class="mi-row"><span class="mi-key">Saat</span><span class="mi-val">@match.MatchDate.ToString("HH:mm", culture)</span></div>
      </div>
    </div>
  </div>
  }

  <div class="mt-2">
    <a asp-controller="Match" asp-action="MatchList" class="back-btn"><i class="bi bi-arrow-left"></i> Tüm Maçlara Dön</a>
  </div>
</div>
</div>
