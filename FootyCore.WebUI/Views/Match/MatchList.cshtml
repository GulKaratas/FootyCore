@model MatchPageViewModel
@{
    ViewData["Title"] = "MatchList";
    Layout = "~/Views/Default/_IndexLayout.cshtml";

    var matches = Model.Matches ?? new List<ResultMatchDto>();
    var liveMatches = matches.Where(x => x.StatusName != null && x.StatusName.Contains("Canlı")).ToList();
    var finishedMatches = matches.Where(x => x.StatusName != null && x.StatusName.Contains("Bitti")).ToList();
    var upcomingMatches = matches.Where(x => x.StatusName != null && (x.StatusName.Contains("Oynanmadı") || x.StatusName.Contains("Yaklaşan"))).ToList();
    var featured = Model.FeaturedMatch ?? matches.FirstOrDefault();
}

<section class="lg-head">
  <div class="wrap">
    <div class="row align-items-center">
      <div class="col-lg-7">
        <div class="lg-badge"><i class="bi bi-trophy-fill"></i> @Model.LeagueName</div>
        <h1 class="lg-title">Hafta <span style="color:var(--green)">@Model.SelectedWeek</span> Sonuçları</h1>
        <p class="lg-sub">@Model.DateRange &nbsp;·&nbsp; @matches.Count Maç</p>
      </div>
      <div class="col-lg-5 d-none d-lg-block">
        <div class="lg-stats">
          <div style="text-align:center"><div class="ls-num">@liveMatches.Count</div><div class="ls-lbl">Canlı</div></div>
          <div style="text-align:center"><div class="ls-num">@finishedMatches.Count</div><div class="ls-lbl">Biten</div></div>
          <div style="text-align:center"><div class="ls-num">@upcomingMatches.Count</div><div class="ls-lbl">Yaklaşan</div></div>
        </div>
      </div>
    </div>
  </div>
</section>

<div class="ftabs-wrap">
  <div class="wrap">
    <div class="ftabs">
      <button class="ftab active" data-f="all">Tüm Maçlar</button>
      <button class="ftab" data-f="live"><span class="live-dot"></span>Canlı<span class="bcnt">@liveMatches.Count</span></button>
      <button class="ftab" data-f="finished">Tamamlananlar</button>
      <button class="ftab" data-f="upcoming">Yaklaşanlar</button>
    </div>
  </div>
</div>

<main>
<div class="wrap" style="padding-top:28px;padding-bottom:56px">

  <div class="feat-wrap" id="featWrap">
    @if (featured != null)
    {
      <div class="feat-lbl">Öne Çıkan Maç</div>
      <a asp-controller="Match" asp-action="MatchDetails" asp-route-id="@featured.MatchId" class="feat-card">
        <div class="row align-items-center g-2">
          <div class="col-5">
            <div class="ft-team">
              <div class="ft-logo" style="border-color:rgba(239,1,7,.4)">
                <img src="@featured.HomeLogoUrl" alt="@featured.HomeTeamName" onerror="this.parentNode.textContent='EV'" />
              </div>
              <div class="ft-name">@featured.HomeTeamName</div>
              <div class="ft-type">Ev Sahibi</div>
            </div>
          </div>
          <div class="col-2 text-center">
            <div class="ft-sc-area">
              <div class="ft-sc">@featured.HomeScore – @featured.AwayScore</div>
              <div class="ft-stat"><i class="bi bi-check2-circle"></i> @featured.StatusName</div>
              <div class="ft-meta">@featured.MatchDate.ToString("HH:mm")</div>
            </div>
          </div>
          <div class="col-5">
            <div class="ft-team">
              <div class="ft-logo" style="border-color:rgba(200,16,46,.4)">
                <img src="@featured.AwayLogoUrl" alt="@featured.AwayTeamName" onerror="this.parentNode.textContent='DEP'" />
              </div>
              <div class="ft-name">@featured.AwayTeamName</div>
              <div class="ft-type">Deplasman</div>
            </div>
          </div>
        </div>
        <div class="text-center mt-3" style="font-size:12px;color:var(--t2)">
          <i class="bi bi-geo-alt"></i> @featured.StadiumName &nbsp;·&nbsp;
          <i class="bi bi-calendar3"></i> @featured.MatchDate.ToString("dd MMMM yyyy") &nbsp;·&nbsp;
          <span style="color:var(--blue)">Detayları Gör →</span>
        </div>
      </a>
    }
  </div>

  <div class="sec-ttl mcw-section" data-s="live">🔴 &nbsp;Canlı Maçlar</div>
  @foreach (var item in liveMatches)
  {
    <div class="mc-wrap mcw" data-s="live">
      <div class="mc live lp">
        <div class="mc-time">
          <div class="mc-min lc">@item.MatchDate.ToString("HH:mm")</div>
          <div class="sbadge sb-live"><span class="live-dot"></span>@item.StatusName</div>
        </div>
        <div class="dvv"></div>
        <div class="mc-teams">
          <div class="mc-tr">
            <div class="tl-sm"><img src="@item.HomeLogoUrl" alt="@item.HomeTeamName" onerror="this.parentNode.textContent='EV'"/></div>
            <span class="tn">@item.HomeTeamName</span>
            <span class="ts">@item.HomeScore</span>
          </div>
          <div class="mc-tr">
            <div class="tl-sm"><img src="@item.AwayLogoUrl" alt="@item.AwayTeamName" onerror="this.parentNode.textContent='DEP'"/></div>
            <span class="tn">@item.AwayTeamName</span>
            <span class="ts">@item.AwayScore</span>
          </div>
        </div>
        <a asp-controller="Match" asp-action="MatchDetails" asp-route-id="@item.MatchId" class="det-btn"><i class="bi bi-chevron-right"></i> <span>Detay</span></a>
      </div>
    </div>
  }

  <div class="sec-ttl mcw-section" data-s="finished" style="margin-top:22px">✅ &nbsp;Tamamlanan Maçlar</div>
  @foreach (var item in finishedMatches)
  {
    <div class="mc-wrap mcw" data-s="finished">
      <a asp-controller="Match" asp-action="MatchDetails" asp-route-id="@item.MatchId" class="mc">
        <div class="mc-time"><div class="mc-min">@item.MatchDate.ToString("HH:mm")</div><div class="sbadge sb-fin">@item.StatusName</div></div>
        <div class="dvv"></div>
        <div class="mc-teams">
          <div class="mc-tr">
            <div class="tl-sm"><img src="@item.HomeLogoUrl" alt="@item.HomeTeamName" onerror="this.parentNode.textContent='EV'"/></div>
            <span class="tn">@item.HomeTeamName</span><span class="ts">@item.HomeScore</span>
          </div>
          <div class="mc-tr">
            <div class="tl-sm"><img src="@item.AwayLogoUrl" alt="@item.AwayTeamName" onerror="this.parentNode.textContent='DEP'"/></div>
            <span class="tn">@item.AwayTeamName</span><span class="ts">@item.AwayScore</span>
          </div>
        </div>
        <span class="det-btn"><i class="bi bi-chevron-right"></i> <span>Detay</span></span>
      </a>
    </div>
  }

  <div class="sec-ttl mcw-section" data-s="upcoming" style="margin-top:22px">🕐 &nbsp;Yaklaşan Maçlar</div>
  @foreach (var item in upcomingMatches)
  {
    <div class="mc-wrap mcw" data-s="upcoming">
      <a asp-controller="Match" asp-action="MatchDetails" asp-route-id="@item.MatchId" class="mc">
        <div class="mc-time"><div class="mc-min bc">@item.MatchDate.ToString("HH:mm")</div><div class="sbadge sb-up">@item.MatchDate.ToString("dd.MM")</div></div>
        <div class="dvv"></div>
        <div class="mc-teams">
          <div class="mc-tr">
            <div class="tl-sm"><img src="@item.HomeLogoUrl" alt="@item.HomeTeamName" onerror="this.parentNode.textContent='EV'"/></div>
            <span class="tn">@item.HomeTeamName</span><span class="ts dim">—</span>
          </div>
          <div class="mc-tr">
            <div class="tl-sm"><img src="@item.AwayLogoUrl" alt="@item.AwayTeamName" onerror="this.parentNode.textContent='DEP'"/></div>
            <span class="tn">@item.AwayTeamName</span><span class="ts dim">—</span>
          </div>
        </div>
        <span class="det-btn"><i class="bi bi-calendar-check"></i> <span>Fikstür</span></span>
      </a>
    </div>
  }

</div>
</main>
