@using FootyCore.DtoLayer.SeasonDto
@model MatchPageViewModel
@{
    ViewData["Title"] = "FixtureList";
    Layout = "~/Views/Default/_IndexLayout.cshtml";

    var culture = new System.Globalization.CultureInfo("tr-TR");
    var seasons = Model.Seasons ?? new List<ResultSeasonDto>();
    var fixtures = Model.Matches ?? new List<ResultMatchDto>();

    var groupedFixtures = fixtures
        .OrderBy(x => x.MatchDate)
        .GroupBy(x => x.MatchDate.Date)
        .ToList();

    var totalMatchCount = fixtures.Count;
    var totalWeeks = 38;
    var firstMatchDate = fixtures.OrderBy(x => x.MatchDate).FirstOrDefault()?.MatchDate;
    var previousWeek = Model.SelectedWeek > 1 ? Model.SelectedWeek - 1 : 1;
    var nextWeek = Model.SelectedWeek < totalWeeks ? Model.SelectedWeek + 1 : totalWeeks;

    var matchDaysText = "-";
    if (groupedFixtures.Count == 1)
        matchDaysText = groupedFixtures[0].Key.ToString("ddd", culture);
    else if (groupedFixtures.Count > 1)
        matchDaysText = $"{groupedFixtures.First().Key.ToString("ddd", culture)}–{groupedFixtures.Last().Key.ToString("ddd", culture)}";

    var monthText = firstMatchDate == null ? "-" : firstMatchDate.Value.ToString("MMMM yyyy", culture);
}

<section class="pg-head">
  <div class="wrap">
    <div class="row align-items-end">
      <div class="col-lg-7">
        <div class="pg-badge"><i class="bi bi-trophy-fill"></i> @Model.LeagueName</div>
        <h1 class="pg-title">Hafta <span style="color:var(--blue)">@Model.SelectedWeek</span> Fikstürü</h1>
        <p class="pg-sub">@Model.DateRange &nbsp;·&nbsp; @totalMatchCount Maç</p>
        <div class="week-nav">
          @if (Model.SelectedWeek > 1)
          {
            <a class="wn-btn" asp-action="FixtureList" asp-route-seasonId="@Model.SelectedSeasonId" asp-route-week="@previousWeek">
              <i class="bi bi-chevron-left"></i> <span>Hafta @previousWeek</span>
            </a>
          }
          <div class="wn-cur">Hafta @Model.SelectedWeek</div>
          @if (Model.SelectedWeek < totalWeeks)
          {
            <a class="wn-btn" asp-action="FixtureList" asp-route-seasonId="@Model.SelectedSeasonId" asp-route-week="@nextWeek">
              <span>Hafta @nextWeek</span> <i class="bi bi-chevron-right"></i>
            </a>
          }
        </div>
      </div>

      <div class="col-lg-5 mt-4 mt-lg-0">
        <div class="match-filter-box">
          <div class="mf-header">
            <span class="mf-icon"><i class="bi bi-filter-circle-fill"></i></span>
            <span>Fikstür Filtreleme</span>
          </div>
          <form method="get" asp-action="FixtureList">
            <div class="mf-selectors-grid">
              <div class="mf-item">
                <label class="mf-lbl" for="seasonSelect">Sezon</label>
                <div class="mf-select-wrapper">
                  <select id="seasonSelect" name="seasonId" class="mf-select" onchange="this.form.submit()">
                    @foreach (var season in seasons)
                    {
                      if (season.SeasonId == Model.SelectedSeasonId)
                      {
                        <option value="@season.SeasonId" selected>@season.SeasonName</option>
                      }
                      else
                      {
                        <option value="@season.SeasonId">@season.SeasonName</option>
                      }
                    }
                  </select>
                  <i class="bi bi-chevron-down mf-caret"></i>
                </div>
              </div>
              <div class="mf-item">
                <label class="mf-lbl" for="weekSelect">Hafta</label>
                <div class="mf-select-wrapper">
                  <select id="weekSelect" name="week" class="mf-select" onchange="this.form.submit()">
                    @for (var weekNumber = 1; weekNumber <= totalWeeks; weekNumber++)
                    {
                      if (weekNumber == Model.SelectedWeek)
                      {
                        <option value="@weekNumber" selected>Hafta @weekNumber</option>
                      }
                      else
                      {
                        <option value="@weekNumber">Hafta @weekNumber</option>
                      }
                    }
                  </select>
                  <i class="bi bi-chevron-down mf-caret"></i>
                </div>
              </div>
            </div>
          </form>
        </div>
      </div>
    </div>
  </div>
</section>

<main>
<div class="wrap">
<div class="content">

  <div class="week-summary">
    <div class="ws-card">
      <div class="ws-num" style="color:var(--blue)">@totalMatchCount</div>
      <div class="ws-lbl">Toplam Maç</div>
    </div>
    <div class="ws-card">
      <div class="ws-num" style="color:var(--gold)">@groupedFixtures.Count</div>
      <div class="ws-lbl">Maç Günü</div>
    </div>
    <div class="ws-card">
      <div class="ws-num" style="color:var(--green)">@matchDaysText</div>
      <div class="ws-lbl">Maç Günleri</div>
    </div>
    <div class="ws-card">
      <div class="ws-num" style="color:var(--live)">@monthText</div>
      <div class="ws-lbl">Ay</div>
    </div>
  </div>

  @if (!groupedFixtures.Any())
  {
    <p>Bu haftada maç yok.</p>
  }

  @for (var dayIndex = 0; dayIndex < groupedFixtures.Count; dayIndex++)
  {
    var day = groupedFixtures[dayIndex];
    <div class="day-group">
      <div class="day-header">
        <span class="day-title">@day.Key.ToString("dddd", culture)</span>
        <span class="day-date">@day.Key.ToString("dd MMMM yyyy", culture)</span>
        <div class="day-line"></div>
        @if (dayIndex == 0)
        {
          <span class="day-badge db-today">Bu Hafta Açılışı</span>
        }
      </div>

      @foreach (var item in day.OrderBy(x => x.MatchDate))
      {
        <div class="fx-card">
          <div class="fx-inner">
            <div class="fx-time-col">
              <div class="fx-time">@item.MatchDate.ToString("HH:mm", culture)</div>
              <div class="top-match-tag">@item.StatusName</div>
            </div>
            <div class="fx-divider"></div>
            <div class="fx-teams">
              <div class="fx-team-home">
                <span class="fx-name home">@item.HomeTeamName</span>
                <div class="fx-logo">
                  <img src="@item.HomeLogoUrl" alt="@item.HomeTeamName" onerror="this.parentNode.textContent='EV'"/>
                </div>
              </div>
              <div class="vs-block">
                <span class="vs-text">VS</span>
              </div>
              <div class="fx-team-away">
                <div class="fx-logo">
                  <img src="@item.AwayLogoUrl" alt="@item.AwayTeamName" onerror="this.parentNode.textContent='DEP'"/>
                </div>
                <span class="fx-name">@item.AwayTeamName</span>
              </div>
            </div>
            <div class="fx-right">
              <span class="fx-stadium"><i class="bi bi-geo-alt" style="font-size:10px;margin-right:3px"></i>@item.StadiumName</span>
              <button type="button" class="notify-btn" onclick="toggleNotify(this)">
                <i class="bi bi-bell"></i> <span>Bildir</span>
              </button>
            </div>
          </div>
        </div>
      }
    </div>
  }

</div>
</div>
</main>
