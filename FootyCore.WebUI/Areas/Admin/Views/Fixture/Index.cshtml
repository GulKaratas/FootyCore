@model List<ResultMatchDto>
@{
    ViewData["Title"] = "Fikstür";
    Layout = "~/Areas/Admin/Views/Admin/_IndexLayout.cshtml";
    var total = Model.Count;
    var live = Model.Count(x => x.StatusName != null && x.StatusName.Contains("Canlı"));
    var planned = Model.Count(x => !x.HomeScore.HasValue);
    var week = total == 0 ? 0 : Model.Max(x => x.Week);
}

<div class="flex flex-col w-full">
    <div class="flex flex-col gap-space-lg mb-space-xl">
        <div class="flex flex-col md:flex-row md:items-end justify-between gap-space-md">
            <div class="flex flex-col">
                <h1 class="font-headline-lg text-headline-lg text-primary tracking-tight">Lig Fikstür Takvimi</h1>
                <p class="font-body-md text-on-surface-variant mt-space-xs max-w-3xl">Sezon maç programı, stadyum ve başlangıç saati.</p>
            </div>
            <div class="flex items-center gap-space-sm self-start md:self-auto">
                <a href="/Admin/Fixture/Create" class="flex items-center gap-space-xs px-space-lg py-space-sm rounded-lg bg-primary-container text-on-primary hover:bg-primary transition-all shadow-md font-label-lg font-semibold">
                    <span class="material-symbols-outlined text-title-md">add_circle</span>
                    <span>Yeni Maç Ekle</span>
                </a>
            </div>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-space-md">
            <div class="bg-surface-container-lowest rounded-xl p-space-md shadow-sm flex items-center justify-between">
                <div class="flex flex-col">
                    <span class="font-label-sm uppercase text-on-surface-variant tracking-wider">Hafta</span>
                    <span class="font-headline-md text-headline-md text-primary mt-space-xs">@(week). Hafta</span>
                    <span class="font-body-sm text-secondary font-medium">@total karşılaşma</span>
                </div>
                <div class="w-12 h-12 rounded-lg bg-secondary-container/50 flex items-center justify-center text-secondary">
                    <span class="material-symbols-outlined text-headline-sm">calendar_today</span>
                </div>
            </div>
            <div class="bg-surface-container-lowest rounded-xl p-space-md shadow-sm flex items-center justify-between">
                <div class="flex flex-col">
                    <span class="font-label-sm uppercase text-on-surface-variant tracking-wider">Canlı müsabaka</span>
                    <span class="font-headline-md text-headline-md text-primary mt-space-xs">@live</span>
                </div>
                <div class="w-12 h-12 rounded-lg bg-error-container/60 flex items-center justify-center text-error">
                    <span class="material-symbols-outlined text-headline-sm">sports_soccer</span>
                </div>
            </div>
            <div class="bg-surface-container-lowest rounded-xl p-space-md shadow-sm flex items-center justify-between">
                <div class="flex flex-col">
                    <span class="font-label-sm uppercase text-on-surface-variant tracking-wider">Skorsuz</span>
                    <span class="font-headline-md text-headline-md text-primary mt-space-xs">@planned</span>
                </div>
                <div class="w-12 h-12 rounded-lg bg-surface-container-high flex items-center justify-center text-secondary">
                    <span class="material-symbols-outlined text-headline-sm">schedule</span>
                </div>
            </div>
        </div>
    </div>

    <div class="bg-surface-container-lowest rounded-xl shadow-md overflow-hidden flex flex-col">
        <div class="p-space-lg flex flex-col sm:flex-row sm:items-center justify-between gap-space-md">
            <div class="flex flex-col">
                <h2 class="font-headline-sm text-headline-sm text-primary tracking-tight">Maç listesi</h2>
                <span class="font-body-sm text-on-surface-variant">Ev sahibi, deplasman, stadyum ve saat</span>
            </div>
            <span class="px-space-md py-space-xs rounded-full bg-surface-container-low text-primary font-label-sm font-semibold uppercase tracking-wider">Toplam @total müsabaka</span>
        </div>
        <div class="overflow-x-auto w-full">
            <table class="w-full text-left">
                <thead>
                    <tr class="bg-surface-container-low text-on-surface-variant font-label-sm uppercase tracking-wider">
                        <th class="py-space-md px-space-lg font-semibold">Durum</th>
                        <th class="py-space-md px-space-md font-semibold">Tarih ve saat</th>
                        <th class="py-space-md px-space-md font-semibold text-right">Ev sahibi</th>
                        <th class="py-space-md px-space-md font-semibold text-center">Skor / saat</th>
                        <th class="py-space-md px-space-md font-semibold">Deplasman</th>
                        <th class="py-space-md px-space-md font-semibold">Stadyum</th>
                        <th class="py-space-md px-space-lg font-semibold text-right">İşlemler</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-surface-container-low text-on-surface">
                    @if (total == 0)
                    {
                        <tr>
                            <td colspan="7" class="py-space-lg px-space-lg text-on-surface-variant">Kayıtlı maç yok.</td>
                        </tr>
                    }
                    @foreach (var item in Model)
                    {
                        var isLive = item.StatusName != null && item.StatusName.Contains("Canlı");
                        var isDone = item.StatusName != null && item.StatusName.Contains("Bitti");
                        var hasScore = item.HomeScore.HasValue && item.AwayScore.HasValue;
                        var homeCode = string.IsNullOrWhiteSpace(item.HomeTeamName) ? "—" : item.HomeTeamName.Substring(0, Math.Min(3, item.HomeTeamName.Length)).ToUpper();
                        var awayCode = string.IsNullOrWhiteSpace(item.AwayTeamName) ? "—" : item.AwayTeamName.Substring(0, Math.Min(3, item.AwayTeamName.Length)).ToUpper();
                        <tr class="hover:bg-surface-container-low/60 transition-colors">
                            <td class="py-space-md px-space-lg whitespace-nowrap">
                                @if (isLive)
                                {
                                    <span class="inline-flex items-center gap-1.5 px-space-sm py-0.5 rounded-full bg-error-container text-error font-label-sm font-bold">Canlı</span>
                                }
                                else if (isDone)
                                {
                                    <span class="inline-flex items-center px-space-sm py-0.5 rounded-full bg-surface-container-high font-label-sm font-semibold">Bitti</span>
                                }
                                else
                                {
                                    <span class="inline-flex items-center px-space-sm py-0.5 rounded-full bg-secondary-container/60 text-secondary font-label-sm font-semibold">@item.StatusName</span>
                                }
                            </td>
                            <td class="py-space-md px-space-md whitespace-nowrap">
                                <div class="flex flex-col">
                                    <span class="font-title-md font-semibold">@item.MatchDate.ToString("dd.MM.yyyy")</span>
                                    <span class="font-body-sm text-on-surface-variant">@(item.Week). hafta · @item.MatchDate.ToString("HH:mm")</span>
                                </div>
                            </td>
                            <td class="py-space-md px-space-md whitespace-nowrap text-right">
                                <div class="inline-flex items-center gap-space-sm justify-end">
                                    <span class="font-title-md font-bold">@item.HomeTeamName</span>
                                    <div class="w-8 h-8 rounded-full bg-surface-container-high flex items-center justify-center"><span class="font-label-sm font-bold text-primary">@homeCode</span></div>
                                </div>
                            </td>
                            <td class="py-space-md px-space-md text-center">
                                @if (hasScore)
                                {
                                    <span class="inline-flex items-center px-space-md py-1 rounded-lg bg-primary-container text-on-primary font-headline-sm font-bold">@item.HomeScore - @item.AwayScore</span>
                                }
                                else
                                {
                                    <span class="inline-flex items-center px-space-md py-1 rounded-lg bg-surface-container-high font-title-md font-bold">@item.MatchDate.ToString("HH:mm")</span>
                                }
                            </td>
                            <td class="py-space-md px-space-md whitespace-nowrap">
                                <div class="inline-flex items-center gap-space-sm">
                                    <div class="w-8 h-8 rounded-full bg-surface-container-high flex items-center justify-center"><span class="font-label-sm font-bold text-secondary">@awayCode</span></div>
                                    <span class="font-title-md font-bold">@item.AwayTeamName</span>
                                </div>
                            </td>
                            <td class="py-space-md px-space-md whitespace-nowrap">
                                <div class="flex items-center gap-space-xs">
                                    <span class="material-symbols-outlined text-title-md text-secondary">location_on</span>
                                    <span class="font-medium">@item.StadiumName</span>
                                </div>
                            </td>
                            <td class="py-space-md px-space-lg text-right">
                                <div class="inline-flex items-center gap-space-xs">
                                    <a href="/Admin/Fixture/Update/@item.MatchId" class="px-space-md py-1 rounded-md bg-surface-container-high text-primary hover:bg-primary hover:text-on-primary font-label-md font-semibold">Düzenle</a>
                                    <a href="/Admin/Fixture/Delete/@item.MatchId" class="p-1.5 rounded-md text-on-surface-variant hover:text-error hover:bg-error-container/40" data-confirm-delete="Bu maç silinsin mi?">
                                        <span class="material-symbols-outlined text-title-md">delete</span>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
