
@{
    ViewData["Title"] = "Index";
    Layout = "~/Areas/Admin/Views/Admin/_IndexLayout.cshtml";
}
 <div class="main-content">

    <!-- Topbar -->

    <header class="top-bar">

      <div class="d-flex align-items-center gap-3">

        <button class="menu-toggle-btn" id="menuToggle" aria-label="Menüyü Aç/Kapa">

          <i class="bi bi-list"></i>

        </button>

        <div class="top-bar-title">

          <h2 class="">Yeni Maç</h2>

          <p class="">Sezon fikstürüne maç ekle.</p>

        </div>

      </div>

      <div>

        <div class="admin-pill">

          <span class="status-dot"></span>

          <span class="">Admin</span>

        </div>

      </div>

    </header>

    <div class="content-container">

      <!-- Form Card -->

      <div class="fc-card">

        <div class="fc-card-title">

          <i class="bi bi-plus-circle" style="color: var(--primary-coral);"></i>

          <span class="">Fikstür Bilgileri</span>

        </div>

        <form id="matchForm">

          <div class="row g-3">

            <!-- Sezon -->

            <div class="col-md-6">

              <label class="form-label" for="seasonSelect">Sezon</label>

              <select class="form-select" id="seasonSelect" required="">

                <option value="2024/2025" selected="">2024/2025</option>

                <option value="2025/2026">2025/2026</option>

              </select>

            </div>

            <!-- Hafta -->

            <div class="col-md-6">

              <label class="form-label" for="weekInput">Hafta (1–38)</label>

              <input type="number" class="form-control" id="weekInput" min="1" max="38" value="26" required="">

            </div>

            <!-- Ev Sahibi -->

            <div class="col-md-6">

              <label class="form-label" for="homeTeam">Ev Sahibi</label>

              <select class="form-select" id="homeTeam" required="">

                <option value="Galatasaray" selected="">Galatasaray</option>

                <option value="Fenerbahçe">Fenerbahçe</option>

                <option value="Beşiktaş">Beşiktaş</option>

                <option value="Trabzonspor">Trabzonspor</option>

                <option value="Arsenal">Arsenal</option>

                <option value="Liverpool">Liverpool</option>

                <option value="Manchester City">Manchester City</option>

                <option value="Chelsea">Chelsea</option>

              </select>

            </div>

            <!-- Deplasman -->

            <div class="col-md-6">

              <label class="form-label" for="awayTeam">Deplasman</label>

              <select class="form-select" id="awayTeam" required="">

                <option value="Galatasaray">Galatasaray</option>

                <option value="Fenerbahçe" selected="">Fenerbahçe</option>

                <option value="Beşiktaş">Beşiktaş</option>

                <option value="Trabzonspor">Trabzonspor</option>

                <option value="Arsenal">Arsenal</option>

                <option value="Liverpool">Liverpool</option>

                <option value="Manchester City">Manchester City</option>

                <option value="Chelsea">Chelsea</option>

              </select>

              <div id="sameTeamAlert" class="mt-1" style="display:none; color: var(--card-red); font-size: 0.82rem; font-weight: 600;">

                <i class="bi bi-exclamation-circle-fill me-1"></i> Ev sahibi ile deplasman takımı aynı seçilemez.

              </div>

            </div>

            <!-- Stadyum -->

            <div class="col-md-6">

              <label class="form-label" for="stadiumSelect">Stadyum</label>

              <select class="form-select" id="stadiumSelect" required="">

                <option value="Rams Park" selected="">Rams Park</option>

                <option value="Ülker">Ülker</option>

                <option value="Tüpraş">Tüpraş</option>

                <option value="Papara Park">Papara Park</option>

                <option value="Emirates">Emirates</option>

                <option value="Etihad">Etihad</option>

              </select>

            </div>

            <!-- Tarih ve Saat -->

            <div class="col-md-6">

              <label class="form-label" for="matchDate">Tarih ve Saat</label>

              <input type="datetime-local" class="form-control" id="matchDate" value="2025-03-29T19:00" required="">

            </div>

            <!-- Durum -->

            <div class="col-md-6">

              <label class="form-label" for="statusSelect">Durum</label>

              <select class="form-select" id="statusSelect" required="">

                <option value="Oynanmadı" selected="">Oynanmadı</option>

                <option value="Yaklaşan">Yaklaşan</option>

                <option value="Canlı">Canlı</option>

                <option value="Bitti">Bitti</option>

              </select>

            </div>

            <!-- Form Actions -->

            <div class="col-12 mt-4 pt-2 border-top d-flex justify-content-end gap-2" style="border-color: var(--border-color) !important;">

              <button type="submit" class="btn-coral" id="submitBtn">

                <i class="bi bi-check2-circle"></i> Maçı Kaydet

              </button>

            </div>

          </div>

        </form>

      </div>

      <!-- Son Fikstür Kayıtları Tablosu -->

      <div class="fc-card p-0 overflow-hidden">

        <div class="p-4 pb-3">

          <div class="fc-card-title mb-0">

            <i class="bi bi-clock-history" style="color: var(--secondary-teal);"></i>

            <span class="">Son Eklenen Fikstürler</span>

          </div>

        </div>

        <div class="table-responsive">

          <table class="table fc-table align-middle">

            <thead>

              <tr>

                <th class="">Hafta</th>

                <th class="">Karşılaşma</th>

                <th class="">Stadyum</th>

                <th class="">Tarih</th>

                <th class="">Durum</th>

              <th class="text-end">İşlemler</th></tr>

            </thead>

            <tbody>

              <tr>

                <td class=""><strong>Hafta 26</strong></td>

                <td class="">

                  <span class="fw-semibold">Galatasaray</span> 

                  <span class="text-muted mx-1">vs</span> 

                  <span class="fw-semibold">Fenerbahçe</span>

                </td>

                <td class="">Rams Park</td>

                <td class="">29 Mart 2025, 19:00</td>

                <td class=""><span class="badge-status badge-teal"><i class="bi bi-circle-fill" style="font-size:6px;"></i> Oynanmadı</span></td>

              <td class="text-end"><div class="d-flex justify-content-end gap-2"><button type="button" class="btn btn-sm btn-light border d-inline-flex align-items-center justify-content-center" style="width: 32px; height: 32px; border-radius: 8px; color: var(--text-muted);" title="Düzenle"><i class="bi bi-pencil"></i></button><button type="button" class="btn btn-sm btn-light border d-inline-flex align-items-center justify-content-center" style="width: 32px; height: 32px; border-radius: 8px; color: var(--card-red);" title="Sil"><i class="bi bi-trash3"></i></button></div></td></tr>

              <tr>

                <td class=""><strong>Hafta 26</strong></td>

                <td class="">

                  <span class="fw-semibold">Arsenal</span> 

                  <span class="text-muted mx-1">vs</span> 

                  <span class="fw-semibold">Chelsea</span>

                </td>

                <td class="">Emirates</td>

                <td class="">30 Mart 2025, 18:30</td>

                <td class=""><span class="badge-status badge-amber"><i class="bi bi-lightning-charge-fill" style="font-size:8px;"></i> Yaklaşan</span></td>

              <td class="text-end"><div class="d-flex justify-content-end gap-2"><button type="button" class="btn btn-sm btn-light border d-inline-flex align-items-center justify-content-center" style="width: 32px; height: 32px; border-radius: 8px; color: var(--text-muted);" title="Düzenle"><i class="bi bi-pencil"></i></button><button type="button" class="btn btn-sm btn-light border d-inline-flex align-items-center justify-content-center" style="width: 32px; height: 32px; border-radius: 8px; color: var(--card-red);" title="Sil"><i class="bi bi-trash3"></i></button></div></td></tr>

              <tr>

                <td class=""><strong>Hafta 25</strong></td>

                <td class="">

                  <span class="fw-semibold">Beşiktaş</span> 

                  <span class="text-muted mx-1">vs</span> 

                  <span class="fw-semibold">Trabzonspor</span>

                </td>

                <td class="">Tüpraş</td>

                <td class="">22 Mart 2025, 20:00</td>

                <td class=""><span class="badge-status badge-green"><i class="bi bi-check-circle-fill" style="font-size:8px;"></i> Bitti</span></td>

              <td class="text-end"><div class="d-flex justify-content-end gap-2"><button type="button" class="btn btn-sm btn-light border d-inline-flex align-items-center justify-content-center" style="width: 32px; height: 32px; border-radius: 8px; color: var(--text-muted);" title="Düzenle"><i class="bi bi-pencil"></i></button><button type="button" class="btn btn-sm btn-light border d-inline-flex align-items-center justify-content-center" style="width: 32px; height: 32px; border-radius: 8px; color: var(--card-red);" title="Sil"><i class="bi bi-trash3"></i></button></div></td></tr>

            </tbody>

          </table>

        </div>

      </div>

    </div>

  </div>

</div>