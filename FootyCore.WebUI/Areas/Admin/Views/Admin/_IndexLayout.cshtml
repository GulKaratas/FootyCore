@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="tr">
<head>
    @await Html.PartialAsync("~/Areas/Admin/Views/Admin/HeadPartial.cshtml")
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="bg-surface font-body-md text-body-md text-on-surface antialiased">
    @await Html.PartialAsync("~/Areas/Admin/Views/Admin/SidebarPartial.cshtml")
    <div class="pl-[248px] min-h-screen">
        @await Html.PartialAsync("~/Areas/Admin/Views/Admin/TopbarPartial.cshtml")
        <main class="w-full pt-[68px] px-space-xl pb-space-2xl bg-surface">
            @RenderBody()
        </main>
    </div>
    @await Html.PartialAsync("~/Areas/Admin/Views/Admin/ScriptPartial.cshtml")
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
