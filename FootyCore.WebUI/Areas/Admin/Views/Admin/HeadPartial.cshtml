<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>FootyCore Yönetim - Fikstür Ekle</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
  <style>
    :root {
      --bg-page: #f6f3ee;
      --bg-card: #ffffff;
      --text-main: #1c2430;
      --text-muted: #5c6778;
      --border-color: #e6e0d6;
      --primary-coral: #ff5c39;
      --primary-coral-hover: #e84c2a;
      --secondary-teal: #0f9d8a;
      --secondary-teal-hover: #0c8272;
      --accent-amber: #f5b942;
      --success-green: #1f9d55;
      --card-yellow: #f5c518;
      --card-red: #e23b4a;
      --radius-default: 14px;
      --shadow-subtle: 0 4px 16px rgba(28, 36, 48, 0.04);
    }

    body {
      background-color: var(--bg-page);
      color: var(--text-main);
      font-family: 'Plus Jakarta Sans', sans-serif;
      margin: 0;
      padding: 0;
      overflow-x: hidden;
    }

    /* Layout */
    .app-wrapper {
      display: flex;
      min-height: 100vh;
      width: 100%;
    }

    .sidebar {
      width: 260px;
      background: var(--bg-card);
      border-right: 1px solid var(--border-color);
      display: flex;
      flex-direction: column;
      position: fixed;
      top: 0;
      bottom: 0;
      left: 0;
      z-index: 1040;
      transition: transform 0.3s ease;
      box-shadow: var(--shadow-subtle);
    }

    .sidebar-brand {
      padding: 24px 20px 20px;
      border-bottom: 1px solid var(--border-color);
    }

    .sidebar-brand h1 {
      font-size: 1.25rem;
      font-weight: 700;
      color: var(--text-main);
      margin: 0;
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .sidebar-brand h1 span {
      color: var(--primary-coral);
    }

    .sidebar-brand .brand-badge {
      font-size: 0.72rem;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      color: var(--text-muted);
      margin-top: 4px;
      display: block;
    }

    .sidebar-nav {
      padding: 20px 14px;
      list-style: none;
      margin: 0;
      flex-grow: 1;
    }

    .sidebar-nav li {
      margin-bottom: 6px;
    }

    .nav-item-link {
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 12px 16px;
      border-radius: var(--radius-default);
      font-weight: 600;
      font-size: 0.92rem;
      color: var(--text-main);
      text-decoration: none;
      transition: all 0.2s ease;
    }

    .nav-item-link i {
      font-size: 1.1rem;
    }

    .nav-item-link:hover {
      background-color: var(--bg-page);
      color: var(--text-main);
    }

    .nav-item-link.active {
      background-color: var(--primary-coral);
      color: #ffffff;
      box-shadow: 0 4px 12px rgba(255, 92, 57, 0.25);
    }

    .main-content {
      margin-left: 260px;
      flex: 1;
      display: flex;
      flex-direction: column;
      min-width: 0;
      min-height: 100vh;
    }

    .content-container {
      max-width: 1100px;
      width: 100%;
      margin: 0 auto;
      padding: 28px 24px 60px;
    }

    /* Header Bar */
    .top-bar {
      background: var(--bg-card);
      border-bottom: 1px solid var(--border-color);
      padding: 16px 24px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      position: sticky;
      top: 0;
      z-index: 1020;
    }

    .top-bar-title h2 {
      font-size: 1.25rem;
      font-weight: 700;
      margin: 0;
      color: var(--text-main);
    }

    .top-bar-title p {
      font-size: 0.85rem;
      color: var(--text-muted);
      margin: 2px 0 0;
    }

    .admin-pill {
      background: var(--bg-page);
      border: 1px solid var(--border-color);
      border-radius: 50px;
      padding: 6px 14px;
      font-size: 0.82rem;
      font-weight: 600;
      display: inline-flex;
      align-items: center;
      gap: 8px;
      color: var(--text-main);
    }

    .admin-pill .status-dot {
      width: 8px;
      height: 8px;
      background: var(--success-green);
      border-radius: 50%;
    }

    /* Mobile toggle */
    .menu-toggle-btn {
      display: none;
      background: transparent;
      border: 1px solid var(--border-color);
      border-radius: 8px;
      padding: 6px 10px;
      font-size: 1.2rem;
      color: var(--text-main);
      cursor: pointer;
    }

    .sidebar-backdrop {
      display: none;
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      bottom: 0;
      background: rgba(28, 36, 48, 0.4);
      z-index: 1035;
    }

    @@media (max-width: 991.98px) {
      .sidebar {
        transform: translateX(-100%);
      }
      .sidebar.open {
        transform: translateX(0);
      }
      .sidebar-backdrop.active {
        display: block;
      }
      .main-content {
        margin-left: 0;
      }
      .menu-toggle-btn {
        display: block;
      }
      .content-container {
        padding: 20px 16px 40px;
      }
    }

    /* Cards & Components */
    .fc-card {
      background: var(--bg-card);
      border: 1px solid var(--border-color);
      border-radius: var(--radius-default);
      box-shadow: var(--shadow-subtle);
      padding: 24px;
      margin-bottom: 24px;
    }

    .fc-card-title {
      font-size: 1.05rem;
      font-weight: 700;
      color: var(--text-main);
      margin-bottom: 20px;
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .form-label {
      font-size: 0.82rem;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.03em;
      color: var(--text-muted);
      margin-bottom: 6px;
    }

    .form-control, .form-select {
      background-color: #ffffff;
      border: 1px solid var(--border-color);
      border-radius: 10px;
      color: var(--text-main);
      font-size: 0.92rem;
      padding: 10px 14px;
      transition: all 0.2s ease;
    }

    .form-control:focus, .form-select:focus {
      border-color: var(--primary-coral);
      box-shadow: 0 0 0 3px rgba(255, 92, 57, 0.15);
      outline: none;
    }

    .btn-coral {
      background-color: var(--primary-coral);
      color: #ffffff;
      border: none;
      border-radius: 10px;
      padding: 11px 24px;
      font-weight: 600;
      font-size: 0.92rem;
      transition: all 0.2s ease;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
    }

    .btn-coral:hover {
      background-color: var(--primary-coral-hover);
      color: #ffffff;
      box-shadow: 0 4px 12px rgba(255, 92, 57, 0.2);
    }

    .btn-outline-teal {
      background: transparent;
      border: 1.5px solid var(--secondary-teal);
      color: var(--secondary-teal);
      border-radius: 10px;
      padding: 10px 20px;
      font-weight: 600;
      font-size: 0.92rem;
      transition: all 0.2s ease;
    }

    .btn-outline-teal:hover {
      background: var(--secondary-teal);
      color: #ffffff;
    }

    /* Badges */
    .badge-status {
      padding: 6px 12px;
      border-radius: 50px;
      font-size: 0.76rem;
      font-weight: 600;
      letter-spacing: 0.02em;
      display: inline-flex;
      align-items: center;
      gap: 6px;
    }

    .badge-teal {
      background-color: rgba(15, 157, 138, 0.12);
      color: var(--secondary-teal);
    }

    .badge-amber {
      background-color: rgba(245, 185, 66, 0.15);
      color: #b88118;
    }

    .badge-green {
      background-color: rgba(31, 157, 85, 0.12);
      color: var(--success-green);
    }

    .badge-coral {
      background-color: rgba(255, 92, 57, 0.12);
      color: var(--primary-coral);
    }

    /* Table styling */
    .fc-table {
      margin: 0;
      width: 100%;
    }

    .fc-table thead th {
      background-color: var(--bg-page);
      color: var(--text-muted);
      font-size: 0.78rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.04em;
      padding: 12px 16px;
      border-bottom: 1px solid var(--border-color);
      border-top: none;
    }

    .fc-table tbody td {
      padding: 14px 16px;
      border-bottom: 1px solid var(--border-color);
      color: var(--text-main);
      font-size: 0.9rem;
      vertical-align: middle;
    }

    .fc-table tbody tr:last-child td {
      border-bottom: none;
    }

    .table-container {
      border: 1px solid var(--border-color);
      border-radius: 12px;
      overflow: hidden;
      background: #ffffff;
    }

    /* Alert Toast */
    .toast-alert {
      display: none;
      position: fixed;
      bottom: 24px;
      right: 24px;
      background: #ffffff;
      border-left: 5px solid var(--success-green);
      border-radius: var(--radius-default);
      box-shadow: 0 10px 30px rgba(0,0,0,0.1);
      padding: 14px 20px;
      z-index: 1090;
      animation: slideIn 0.3s ease forwards;
    }

    @@keyframes slideIn {
      from { transform: translateY(20px); opacity: 0; }
      to { transform: translateY(0); opacity: 1; }
    }
  </style>
