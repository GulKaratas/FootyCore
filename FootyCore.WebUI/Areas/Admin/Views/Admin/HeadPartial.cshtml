    <style>
    @@layer base {
        html, body { margin: 0; padding: 0; }
        body { overscroll-behavior: none; }
        main > :first-child { margin-top: 0 !important; }
        main > :last-child { margin-bottom: 0 !important; }
    }
    ::-webkit-scrollbar { display: none; }
    .material-symbols-outlined { font-variation-settings: 'FILL' 0, 'wght' 500, 'GRAD' 0, 'opsz' 24; }

    main .rounded-xl.bg-surface-container-lowest,
    main .rounded-xl.bg-white,
    main .rounded-xl.bg-surface-container-low,
    main .rounded-lg.bg-surface-container-lowest,
    main .rounded-lg.bg-surface-container-low,
    main .rounded-lg.bg-white {
        border: 1px solid #b08990 !important;
        box-shadow: 0 8px 24px rgba(90, 25, 44, 0.14) !important;
    }

    main .text-on-surface-variant {
        color: #3a2a2e !important;
    }

    main input:not([type="hidden"]):not([type="checkbox"]):not([type="radio"]),
    main select,
    main textarea {
        background-color: #ffffff !important;
        color: #23191d !important;
        border: 1px solid #6d555a !important;
    }

    main input::placeholder,
    main textarea::placeholder {
        color: #5c454a !important;
    }

    main select option {
        background-color: #ffffff;
        color: #23191d;
    }

    main button.bg-surface-container-lowest,
    main button.bg-surface-container-low,
    main button.bg-surface-container-high,
    main a.bg-surface-container-lowest,
    main a.bg-surface-container-low,
    main a.bg-surface-container-high {
        background-color: #ffffff !important;
        color: #23191d !important;
        border: 1px solid #6d555a !important;
