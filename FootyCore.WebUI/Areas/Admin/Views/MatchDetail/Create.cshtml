@model MatchEventFormViewModel
@{
    ViewData["Title"] = "Yeni Maç Olayı";
    Layout = "~/Areas/Admin/Views/Admin/_IndexLayout.cshtml";
    var selected = Model.Matches.FirstOrDefault(x => x.MatchId == Model.MatchId) ?? Model.Matches.FirstOrDefault();
    var banner = selected == null
        ? "Müsabaka seçilmedi"
        : (string.IsNullOrWhiteSpace(selected.HomeTeamName) ? "Ev" : selected.HomeTeamName)
            + " vs "
            + (string.IsNullOrWhiteSpace(selected.AwayTeamName) ? "Deplasman" : selected.AwayTeamName);
    var bannerSub = selected == null
        ? "Listeden bir maç seç"
        : selected.Week + ". hafta · " + (selected.StadiumName ?? "");
}

<div class="flex flex-col w-full">
    <nav class="flex items-center gap-space-xs font-label-md text-on-surface-variant mb-space-md">
        <a class="hover:text-primary flex items-center gap-1" href="/Admin/MatchDetail">
            <span class="material-symbols-outlined text-[15px] text-secondary">sports</span>
            <span>Maç Olayları</span>
        </a>
        <span class="material-symbols-outlined text-[14px]">chevron_right</span>
        <span class="text-primary font-semibold">Yeni Olay Ekle</span>
    </nav>

    <div class="mb-space-xl">
        <h1 class="font-headline-lg text-headline-lg text-primary tracking-tight">Yeni Maç Olayı Kaydı</h1>
        <p class="font-body-md text-on-surface-variant mt-space-xs max-w-2xl">Gol, sarı kart, kırmızı kart veya oyuncu değişikliği. Değişiklikte açıklama Giren / Çıkan olarak yazılır.</p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-space-lg items-start">
        <div class="lg:col-span-8">
            <div class="bg-surface-container-lowest rounded-xl shadow-sm overflow-hidden">
                <div class="bg-surface-container-low px-space-xl py-space-lg flex items-center gap-space-md">
                    <div class="h-12 w-12 rounded-xl bg-primary flex items-center justify-center text-on-primary">
                        <span class="material-symbols-outlined text-headline-sm">sports</span>
                    </div>
                    <div class="flex flex-col">
                        <span class="font-headline-sm text-headline-sm text-primary" id="eventBanner">@banner</span>
                        <span class="font-label-md text-on-surface-variant" id="eventBannerSub">@bannerSub</span>
                    </div>
                </div>

                <form method="post" class="p-space-xl flex flex-col gap-space-lg">
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-space-lg">
                        <div class="flex flex-col gap-space-xs md:col-span-2">
                            <label class="font-label-md font-semibold" asp-for="MatchId">Hedef müsabaka</label>
                            <select asp-for="MatchId" class="w-full h-11 px-space-md rounded-lg bg-surface-container-low focus:outline-none" id="matchId">
                                @if (Model.Matches.Count == 0)
                                {
                                    <option value="0">Kayıtlı maç yok</option>
                                }
                                @foreach (var match in Model.Matches)
                                {
                                    var home = string.IsNullOrWhiteSpace(match.HomeTeamName) ? "Ev" : match.HomeTeamName;
                                    var away = string.IsNullOrWhiteSpace(match.AwayTeamName) ? "Deplasman" : match.AwayTeamName;
                                    <option value="@match.MatchId" data-label="@home vs @away" data-sub="@(match.Week). hafta · @match.StadiumName">@home vs @away (@(match.Week). hafta)</option>
                                }
                            </select>
                        </div>

                        <div class="flex flex-col gap-space-xs">
                            <label class="font-label-md font-semibold" asp-for="ActionType">Olay türü</label>
                            <select asp-for="ActionType" class="w-full h-11 px-space-md rounded-lg bg-surface-container-low focus:outline-none">
                                <option>Gol</option>
                                <option>Sarı Kart</option>
                                <option>Kırmızı Kart</option>
                                <option>Değişiklik</option>
                            </select>
                        </div>

                        <div class="flex flex-col gap-space-xs">
                            <label class="font-label-md font-semibold" asp-for="TeamId">İlgili kulüp</label>
                            <select asp-for="TeamId" class="w-full h-11 px-space-md rounded-lg bg-surface-container-low focus:outline-none">
                                @foreach (var team in Model.Teams)
                                {
                                    <option value="@team.TeamId">@team.TeamName</option>
                                }
                            </select>
                        </div>

                        <div class="flex flex-col gap-space-xs">
                            <label class="font-label-md font-semibold" asp-for="Minute">Dakika</label>
                            <input asp-for="Minute" type="number" min="1" max="130" class="w-full h-11 px-space-md rounded-lg bg-surface-container-low focus:outline-none" />
                        </div>

                        <div class="flex flex-col gap-space-xs">
                            <label class="font-label-md font-semibold" asp-for="Description">Açıklama</label>
                            <input asp-for="Description" class="w-full h-11 px-space-md rounded-lg bg-surface-container-low focus:outline-none" placeholder="Gol veya kartta oyuncu. Değişiklikte Giren / Çıkan" />
                        </div>
                    </div>

                    <div class="flex items-center justify-end gap-space-md">
                        <a href="/Admin/MatchDetail" class="px-space-xl py-space-sm rounded-lg bg-surface-container-high font-label-lg font-semibold">Vazgeç</a>
                        <button type="submit" class="inline-flex items-center gap-space-xs px-space-xl py-space-sm rounded-lg bg-primary-container text-on-primary font-label-lg font-semibold hover:bg-primary">
                            <span class="material-symbols-outlined text-title-md">check_circle</span>
                            Kaydet
                        </button>
                    </div>
                </form>
            </div>
        </div>

        <div class="lg:col-span-4 bg-surface-container-lowest p-space-xl rounded-xl shadow-sm">
            <h2 class="font-headline-sm text-primary mb-space-md">Kayıt</h2>
            <p class="font-body-sm text-on-surface-variant">Türler: Gol, Sarı Kart, Kırmızı Kart, Değişiklik. Oyuncu tablosu yok; isim açıklama alanına yazılır. Değişiklikte açıklama Giren / Çıkan biçimindedir.</p>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            var select = document.getElementById("matchId");
            var title = document.getElementById("eventBanner");
            var sub = document.getElementById("eventBannerSub");
            function refresh() {
                if (!select || !title || !sub) return;
                var option = select.options[select.selectedIndex];
                if (!option) return;
                title.textContent = option.getAttribute("data-label") || option.text;
                sub.textContent = option.getAttribute("data-sub") || "";
            }
            if (select) select.addEventListener("change", refresh);
        })();
    </script>
}
