@model MatchEventPageViewModel
@{
    ViewData["Title"] = "Maç Olayları";
    Layout = "~/Areas/Admin/Views/Admin/_IndexLayout.cshtml";
    var events = Model.Events ?? new List<ResultMatchDetailDto>();
    var featured = Model.Featured;
    var featuredEvents = featured == null ? new List<ResultMatchDetailDto>() : events.Where(x => x.MatchId == featured.MatchId).ToList();
    var goals = featuredEvents.Where(x => x.ActionType == "Gol").OrderBy(x => x.Minute).ToList();
    var goalCount = events.Count(x => x.ActionType == "Gol");
    var yellowCount = events.Count(x => x.ActionType == "Sarı Kart");
    var redCount = events.Count(x => x.ActionType == "Kırmızı Kart");
    var subCount = events.Count(x => x.ActionType == "Değişiklik");
    var home = featured == null || string.IsNullOrWhiteSpace(featured.HomeTeamName) ? "Ev sahibi" : featured.HomeTeamName;
    var away = featured == null || string.IsNullOrWhiteSpace(featured.AwayTeamName) ? "Deplasman" : featured.AwayTeamName;
    var hasScore = featured != null && featured.HomeScore.HasValue && featured.AwayScore.HasValue;
    var homePoss = featured?.Statistic?.HomePossession ?? 0;
    var awayPoss = featured?.Statistic?.AwayPossession ?? 0;
}

<div class="flex flex-col w-full gap-space-lg">
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-space-md">
        <div class="flex flex-col gap-space-xs">
            <h1 class="font-headline-lg text-headline-lg text-primary tracking-tight">Maç Olay Akışı</h1>
            <p class="font-body-md text-on-surface-variant">Gol, sarı kart, kırmızı kart ve oyuncu değişikliği.</p>
        </div>
        <a href="/Admin/MatchDetail/Create" class="inline-flex items-center gap-space-xs px-space-lg py-space-sm rounded-lg bg-primary-container text-on-primary font-title-md shadow-md hover:bg-primary self-start">
            <span class="material-symbols-outlined">add_circle</span>
            <span>Yeni Olay Ekle</span>
        </a>
    </div>

    <div class="relative overflow-hidden rounded-xl bg-surface-container-lowest shadow-md p-space-xl">
        <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-space-xl">
            <div class="flex flex-col sm:flex-row sm:items-center gap-space-lg">
                <div class="flex items-center gap-space-md">
                    <div class="flex flex-col items-center">
                        <span class="font-headline-md text-headline-md text-on-surface font-semibold">@home</span>
                        <span class="font-label-sm text-on-surface-variant tracking-wider uppercase">Ev sahibi</span>
                    </div>
                    <div class="px-space-lg py-space-xs rounded-xl bg-surface-container text-primary font-headline-lg font-bold">@(hasScore ? $"{featured.HomeScore} - {featured.AwayScore}" : "—")</div>
                    <div class="flex flex-col items-center">
                        <span class="font-headline-md text-headline-md text-on-surface font-semibold">@away</span>
                        <span class="font-label-sm text-on-surface-variant tracking-wider uppercase">Deplasman</span>
                    </div>
                </div>
                <div class="flex flex-col justify-center">
                    <div class="flex items-center gap-space-xs flex-wrap">
                        <span class="inline-flex items-center gap-1.5 px-space-sm py-0.5 rounded-full bg-surface-container text-primary font-label-sm font-bold uppercase">
                            @(featured?.StatusName ?? "Maç yok")
                        </span>
                        <span class="font-label-md text-on-surface-variant flex items-center gap-1">
                            <span class="material-symbols-outlined text-base text-secondary">stadium</span>
                            @(featured?.StadiumName ?? "")
                        </span>
                    </div>
                    <div class="font-label-sm text-secondary mt-1 font-semibold uppercase tracking-wider">@(featured?.Week ?? 0). Hafta</div>
                </div>
            </div>
            <div class="flex flex-col gap-space-xs bg-surface-container-low p-space-md rounded-xl max-w-xl">
                <div class="flex items-center justify-between text-on-surface-variant font-label-sm uppercase font-semibold">
                    <span>Goller</span>
                    <span class="text-secondary">Top: %@homePoss - %@awayPoss</span>
                </div>
                <div class="flex flex-wrap items-center gap-space-sm pt-space-xs">
                    @if (goals.Count == 0)
                    {
                        <span class="font-body-sm text-on-surface-variant">Bu maçta gol kaydı yok.</span>
                    }
                    @foreach (var goal in goals)
                    {
                        <span class="inline-flex items-center gap-1.5 px-space-sm py-1 rounded-lg bg-surface-container-lowest text-body-sm shadow-sm"><span class="font-semibold text-primary">@(goal.Minute)'</span> @goal.Description</span>
                    }
                </div>
            </div>
        </div>
    </div>

    <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-space-md">
        <div class="flex items-center gap-space-xs overflow-x-auto" id="filterTabs">
            <button type="button" class="px-space-md py-space-xs rounded-lg bg-primary-container text-on-primary font-label-lg font-semibold shadow-sm" data-type="all">Tümü</button>
            <button type="button" class="px-space-md py-space-xs rounded-lg bg-surface-container-lowest text-on-surface-variant font-label-lg shadow-sm" data-type="goal">Goller</button>
            <button type="button" class="px-space-md py-space-xs rounded-lg bg-surface-container-lowest text-on-surface-variant font-label-lg shadow-sm" data-type="card">Kartlar</button>
            <button type="button" class="px-space-md py-space-xs rounded-lg bg-surface-container-lowest text-on-surface-variant font-label-lg shadow-sm" data-type="substitution">Değişiklikler</button>
        </div>
        <div class="relative w-full lg:w-72">
            <span class="material-symbols-outlined absolute left-3 top-2.5 text-on-surface-variant">search</span>
            <input class="w-full h-10 pl-10 pr-4 rounded-lg bg-surface-container-lowest shadow-sm focus:outline-none" id="searchInput" placeholder="Oyuncu veya kulüp ara" type="text" />
        </div>
    </div>

    <div class="rounded-xl bg-surface-container-lowest shadow-md overflow-hidden">
        <div class="overflow-x-auto">
            <table class="w-full text-left" id="eventTable">
                <thead>
                    <tr class="bg-surface-container-low text-on-surface-variant font-label-sm uppercase tracking-wider">
                        <th class="py-space-md px-space-lg">Dakika</th>
                        <th class="py-space-md px-space-md">Olay türü</th>
                        <th class="py-space-md px-space-md">Kulüp</th>
                        <th class="py-space-md px-space-md">Açıklama</th>
                        <th class="py-space-md px-space-lg text-right">İşlemler</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-surface-container-high text-on-surface">
                    @if (events.Count == 0)
                    {
                        <tr>
                            <td class="py-space-lg px-space-lg text-on-surface-variant" colspan="5">Kayıtlı maç olayı yok.</td>
                        </tr>
                    }
                    @foreach (var item in events)
                    {
                        var category = item.ActionType == "Gol" ? "goal" : item.ActionType == "Değişiklik" ? "substitution" : "card";
                        var club = string.IsNullOrWhiteSpace(item.TeamName) ? "Kulüp #" + item.TeamId : item.TeamName;
                        var typeStyle = item.ActionType == "Gol"
                            ? "background:#e5f6ea;color:#146c43;border:1px solid #8dceb0;"
                            : item.ActionType == "Sarı Kart"
                                ? "background:#fff4d6;color:#8a5a00;border:1px solid #e6c36a;"
                                : item.ActionType == "Kırmızı Kart"
                                    ? "background:#fde8ea;color:#9f1239;border:1px solid #f3a8b5;"
                                    : "background:#ffdfa0;color:#5a192c;border:1px solid #e2c27a;";
                        <tr class="hover:bg-surface-container-low/50" data-category="@category">
                            <td class="py-space-md px-space-lg font-headline-sm text-primary font-bold">@(item.Minute)'</td>
                            <td class="py-space-md px-space-md">
                                <span class="inline-flex items-center px-space-sm py-1 rounded-lg font-label-md font-bold shadow-sm" style="@typeStyle">@item.ActionType</span>
                            </td>
                            <td class="py-space-md px-space-md font-semibold">@club</td>
                            <td class="py-space-md px-space-md">@item.Description</td>
                            <td class="py-space-md px-space-lg text-right">
                                <div class="inline-flex items-center justify-end gap-space-xs">
                                    <a href="/Admin/MatchDetail/Update/@item.MatchDetailId" class="inline-flex items-center gap-1 px-space-md py-1 rounded-lg font-label-md font-semibold shadow-sm" style="background:#762f42;color:#fff;border:1px solid #5a192c;">Düzenle</a>
                                    <a href="/Admin/MatchDetail/Delete/@item.MatchDetailId" class="inline-flex items-center gap-1 px-space-md py-1 rounded-lg font-label-md font-semibold shadow-sm" style="background:#fde8ea;color:#9f1239;border:1px solid #e7a8b2;" data-confirm-delete="Bu olay silinsin mi?">Sil</a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div class="grid grid-cols-2 sm:grid-cols-4 gap-space-md">
        <div class="flex flex-col items-center justify-center p-space-md rounded-xl bg-surface-container-lowest shadow-sm">
            <span class="material-symbols-outlined text-emerald-700 text-headline-md">sports_soccer</span>
            <span class="font-headline-lg text-headline-lg font-bold">@goalCount</span>
            <span class="font-label-sm uppercase text-on-surface-variant">Gol</span>
        </div>
        <div class="flex flex-col items-center justify-center p-space-md rounded-xl bg-surface-container-lowest shadow-sm">
            <span class="w-4 h-6 bg-amber-500 rounded-sm inline-block"></span>
            <span class="font-headline-lg text-headline-lg font-bold">@yellowCount</span>
            <span class="font-label-sm uppercase text-on-surface-variant">Sarı kart</span>
        </div>
        <div class="flex flex-col items-center justify-center p-space-md rounded-xl bg-surface-container-lowest shadow-sm">
            <span class="w-4 h-6 bg-rose-600 rounded-sm inline-block"></span>
            <span class="font-headline-lg text-headline-lg font-bold">@redCount</span>
            <span class="font-label-sm uppercase text-on-surface-variant">Kırmızı kart</span>
        </div>
        <div class="flex flex-col items-center justify-center p-space-md rounded-xl bg-surface-container-lowest shadow-sm">
            <span class="material-symbols-outlined text-secondary text-headline-md">sync_alt</span>
            <span class="font-headline-lg text-headline-lg font-bold">@subCount</span>
            <span class="font-label-sm uppercase text-on-surface-variant">Değişiklik</span>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            var tabs = document.querySelectorAll("#filterTabs button");
            var rows = document.querySelectorAll("#eventTable tbody tr");
            var searchInput = document.getElementById("searchInput");
            var current = "all";

            function apply() {
                var val = searchInput ? searchInput.value.toLowerCase().trim() : "";
                rows.forEach(function (row) {
                    var cat = row.getAttribute("data-category") || "";
                    var text = row.innerText.toLowerCase();
                    var catOk = current === "all" || cat.indexOf(current) >= 0;
                    row.style.display = catOk && text.indexOf(val) >= 0 ? "" : "none";
                });
            }

            tabs.forEach(function (tab) {
                tab.addEventListener("click", function () {
                    current = tab.getAttribute("data-type");
                    tabs.forEach(function (t) {
                        t.classList.remove("bg-primary-container", "text-on-primary", "font-semibold");
                        t.classList.add("bg-surface-container-lowest", "text-on-surface-variant");
                    });
                    tab.classList.add("bg-primary-container", "text-on-primary", "font-semibold");
                    tab.classList.remove("bg-surface-container-lowest", "text-on-surface-variant");
                    apply();
                });
            });
            if (searchInput) searchInput.addEventListener("input", apply);
        })();
    </script>
}
