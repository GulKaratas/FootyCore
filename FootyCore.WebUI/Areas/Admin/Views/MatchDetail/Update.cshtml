@model MatchEventFormViewModel
@{
    ViewData["Title"] = "Maç Olayı Düzenle";
    Layout = "~/Areas/Admin/Views/Admin/_IndexLayout.cshtml";
    var selected = Model.Matches.FirstOrDefault(x => x.MatchId == Model.MatchId);
    var matchLabel = selected == null
        ? "Maç #" + Model.MatchId
        : (string.IsNullOrWhiteSpace(selected.HomeTeamName) ? "Ev" : selected.HomeTeamName)
            + " vs "
            + (string.IsNullOrWhiteSpace(selected.AwayTeamName) ? "Deplasman" : selected.AwayTeamName);
}

<div class="flex flex-col w-full max-w-[1440px] mx-auto gap-space-lg">
    <nav class="flex items-center gap-space-xs font-label-md text-on-surface-variant">
        <a class="hover:text-primary flex items-center gap-space-xs" href="/Admin/MatchDetail">
            <span class="material-symbols-outlined text-body-md">sports</span>
            <span>Maç Olayları</span>
        </a>
        <span class="material-symbols-outlined text-body-sm">chevron_right</span>
        <span class="text-on-surface font-semibold">Olay düzenle #@Model.MatchDetailId</span>
    </nav>

    <div>
        <h1 class="font-headline-lg text-headline-lg text-primary tracking-tight">Maç Olay Kaydını Düzenle</h1>
        <p class="font-body-lg text-on-surface-variant">@matchLabel · @(Model.Minute)' @Model.ActionType</p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-space-lg items-start">
        <div class="lg:col-span-8">
            <div class="rounded-xl bg-surface-container-lowest p-space-xl shadow-sm">
                <div class="flex items-center gap-space-md mb-space-lg">
                    <div class="w-14 h-14 rounded-xl bg-primary-container text-on-primary flex items-center justify-center">
                        <span class="material-symbols-outlined text-3xl">sports_soccer</span>
                    </div>
                    <div>
                        <span class="font-label-sm uppercase tracking-wider text-secondary font-bold">@Model.ActionType</span>
                        <h2 class="font-headline-sm text-primary">@(Model.Minute)' @(string.IsNullOrWhiteSpace(Model.Description) ? Model.ActionType : Model.Description)</h2>
                    </div>
                </div>

                <form method="post" class="flex flex-col gap-space-lg">
                    <input type="hidden" asp-for="MatchDetailId" />
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-space-md">
                        <div class="flex flex-col gap-space-xs md:col-span-2">
                            <label class="font-label-md font-semibold" asp-for="MatchId">Müsabaka</label>
                            <select asp-for="MatchId" class="w-full h-11 px-space-md rounded-lg bg-surface-container-low focus:outline-none">
                                @foreach (var match in Model.Matches)
                                {
                                    var home = string.IsNullOrWhiteSpace(match.HomeTeamName) ? "Ev" : match.HomeTeamName;
                                    var away = string.IsNullOrWhiteSpace(match.AwayTeamName) ? "Deplasman" : match.AwayTeamName;
                                    <option value="@match.MatchId">@home vs @away (@(match.Week). hafta)</option>
                                }
                            </select>
                        </div>
                        <div class="flex flex-col gap-space-xs">
                            <label class="font-label-md font-semibold" asp-for="ActionType">Olay türü</label>
                            <select asp-for="ActionType" class="w-full h-11 px-space-md rounded-lg bg-surface-container-low focus:outline-none">
                                <option>Gol</option>
                                <option>Sarı Kart</option>
                                <option>Kırmızı Kart</option>
                                <option>Değişiklik</option>
                            </select>
                        </div>
                        <div class="flex flex-col gap-space-xs">
                            <label class="font-label-md font-semibold" asp-for="Minute">Dakika</label>
                            <input asp-for="Minute" type="number" min="1" max="130" class="w-full h-11 px-space-md rounded-lg bg-surface-container-low focus:outline-none" />
                        </div>
                        <div class="flex flex-col gap-space-xs">
                            <label class="font-label-md font-semibold" asp-for="TeamId">Kulüp</label>
                            <select asp-for="TeamId" class="w-full h-11 px-space-md rounded-lg bg-surface-container-low focus:outline-none">
                                @foreach (var team in Model.Teams)
                                {
                                    <option value="@team.TeamId">@team.TeamName</option>
                                }
                            </select>
                        </div>
                        <div class="flex flex-col gap-space-xs">
                            <label class="font-label-md font-semibold" asp-for="Description">Açıklama</label>
                            <input asp-for="Description" class="w-full h-11 px-space-md rounded-lg bg-surface-container-low focus:outline-none" placeholder="Giren / Çıkan" />
                        </div>
                    </div>

                    <div class="flex flex-col-reverse sm:flex-row items-stretch sm:items-center justify-between gap-space-md pt-space-md">
                        <a href="/Admin/MatchDetail/Delete/@Model.MatchDetailId" data-confirm-delete="Bu maç olayı silinsin mi?" class="h-11 px-space-lg rounded-lg bg-surface-container-lowest text-error font-label-lg flex items-center justify-center gap-space-xs shadow-sm">
                            <span class="material-symbols-outlined text-body-lg">delete</span>
                            Sil
                        </a>
                        <div class="flex items-center gap-space-sm justify-end">
                            <a href="/Admin/MatchDetail" class="h-11 px-space-lg rounded-lg bg-surface-container-high font-label-lg flex items-center">Vazgeç</a>
                            <button type="submit" class="h-11 px-space-xl rounded-lg bg-primary-container text-on-primary font-label-lg flex items-center gap-space-xs">
                                <span class="material-symbols-outlined text-body-lg">check_circle</span>
                                Güncellemeyi kaydet
                            </button>
                        </div>
                    </div>
                </form>
            </div>
        </div>

        <div class="lg:col-span-4 rounded-xl bg-surface-container-lowest p-space-lg shadow-sm">
            <h3 class="font-headline-sm text-primary mb-space-sm">@matchLabel</h3>
            <p class="font-body-sm text-on-surface-variant">Kayıt maç, kulüp, tür, dakika ve açıklamadan oluşur. Kart sayıları bu listeden hesaplanır.</p>
        </div>
    </div>
</div>
