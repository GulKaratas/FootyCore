@model List<ResultMatchDto>
@{
    ViewData["Title"] = "Skorlar";
    Layout = "~/Areas/Admin/Views/Admin/_IndexLayout.cshtml";
    var matches = Model ?? new List<ResultMatchDto>();
    var live = matches.Count(x => x.StatusName != null && x.StatusName.Contains("Canlı"));
    var missing = matches.Count(x => !x.HomeScore.HasValue || !x.AwayScore.HasValue);
}

<div class="flex flex-col w-full gap-space-xl">
    <div class="flex flex-col lg:flex-row lg:items-end justify-between gap-space-lg">
        <div class="flex flex-col">
            <h1 class="font-headline-lg text-headline-lg text-primary tracking-tight">Skor ve Sonuç Tablosu</h1>
            <p class="font-body-md text-on-surface-variant max-w-2xl mt-1">İlk yarı, maç sonucu ve topa sahip olma.</p>
        </div>
        <a href="/Admin/Match/Create" class="flex items-center gap-space-xs px-space-lg py-space-sm bg-primary hover:bg-primary-container text-on-primary rounded-lg shadow-md font-label-lg font-semibold">
            <span class="material-symbols-outlined">add</span>
            <span>Yeni Skor Kaydı</span>
        </a>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-space-lg">
        <div class="bg-surface-container-lowest rounded-xl p-space-lg shadow-sm flex items-center justify-between">
            <div>
                <span class="font-label-sm uppercase tracking-wider text-on-surface-variant font-semibold">Canlı karşılaşmalar</span>
                <div class="font-headline-lg text-headline-lg text-primary font-bold mt-space-xs">@live</div>
            </div>
            <div class="w-12 h-12 rounded-xl bg-surface-container flex items-center justify-center text-primary">
                <span class="material-symbols-outlined">timelapse</span>
            </div>
        </div>
        <div class="bg-surface-container-lowest rounded-xl p-space-lg shadow-sm flex items-center justify-between">
            <div>
                <span class="font-label-sm uppercase tracking-wider text-on-surface-variant font-semibold">Skorsuz maç</span>
                <div class="font-headline-lg text-headline-lg text-secondary font-bold mt-space-xs">@missing</div>
            </div>
            <div class="w-12 h-12 rounded-xl bg-secondary-container/40 flex items-center justify-center text-secondary">
                <span class="material-symbols-outlined">scoreboard</span>
            </div>
        </div>
        <div class="bg-surface-container-lowest rounded-xl p-space-lg shadow-sm flex items-center justify-between">
            <div>
                <span class="font-label-sm uppercase tracking-wider text-on-surface-variant font-semibold">Listelenen maç</span>
                <div class="font-headline-lg text-headline-lg text-on-surface font-bold mt-space-xs">@matches.Count</div>
            </div>
            <div class="w-12 h-12 rounded-xl bg-surface-container-high flex items-center justify-center text-primary">
                <span class="material-symbols-outlined">format_list_numbered</span>
            </div>
        </div>
    </div>

    <div class="bg-surface-container-lowest rounded-xl shadow-md overflow-hidden flex flex-col">
        <div class="overflow-x-auto w-full">
            <table class="w-full text-left border-collapse">
                <thead>
                    <tr class="bg-surface-container-low text-on-surface-variant">
                        <th class="py-space-md px-space-lg font-label-sm uppercase tracking-wider">Durum</th>
                        <th class="py-space-md px-space-lg font-label-sm uppercase tracking-wider">Ev sahibi</th>
                        <th class="py-space-md px-space-md font-label-sm uppercase tracking-wider text-center">İlk yarı</th>
                        <th class="py-space-md px-space-lg font-label-sm uppercase tracking-wider text-center">Maç sonucu</th>
                        <th class="py-space-md px-space-lg font-label-sm uppercase tracking-wider">Deplasman</th>
                        <th class="py-space-md px-space-lg font-label-sm uppercase tracking-wider min-w-[180px]">Topa sahip olma</th>
                        <th class="py-space-md px-space-lg font-label-sm uppercase tracking-wider text-right">İşlemler</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-surface-container-high/60">
                    @if (matches.Count == 0)
                    {
                        <tr>
                            <td class="py-space-lg px-space-lg text-on-surface-variant" colspan="7">Kayıtlı maç yok.</td>
                        </tr>
                    }
                    @foreach (var item in matches)
                    {
                        var home = string.IsNullOrWhiteSpace(item.HomeTeamName) ? "Ev" : item.HomeTeamName;
                        var away = string.IsNullOrWhiteSpace(item.AwayTeamName) ? "Deplasman" : item.AwayTeamName;
                        var homeCode = home.Length < 3 ? home.ToUpper() : home.Substring(0, 3).ToUpper();
                        var awayCode = away.Length < 3 ? away.ToUpper() : away.Substring(0, 3).ToUpper();
                        var hasScore = item.HomeScore.HasValue && item.AwayScore.HasValue;
                        var half = item.Statistic == null ? "—" : item.Statistic.HomeFirstHalfGoals + " - " + item.Statistic.AwayFirstHalfGoals;
                        var homePoss = item.Statistic?.HomePossession ?? 0;
                        var awayPoss = item.Statistic?.AwayPossession ?? 0;
                        <tr class="hover:bg-surface-container-low/50 transition-colors">
                            <td class="py-space-lg px-space-lg whitespace-nowrap font-semibold">@item.StatusName</td>
                            <td class="py-space-lg px-space-lg whitespace-nowrap">
                                <div class="flex items-center gap-space-md">
                                    <div class="w-10 h-10 rounded-lg bg-surface-container flex items-center justify-center font-label-sm font-bold text-primary">@homeCode</div>
                                    <div class="flex flex-col">
                                        <span class="font-title-md font-semibold">@home</span>
                                        <span class="font-body-sm text-on-surface-variant">@item.StadiumName</span>
                                    </div>
                                </div>
                            </td>
                            <td class="py-space-lg px-space-md text-center"><span class="font-label-sm font-semibold bg-white px-space-sm py-1 rounded border border-[#b08990]">@half</span></td>
                            <td class="py-space-lg px-space-lg text-center">
                                @if (hasScore)
                                {
                                    <span class="inline-flex px-space-lg py-1.5 rounded-lg bg-primary-container text-on-primary font-headline-md font-bold">@item.HomeScore - @item.AwayScore</span>
                                }
                                else
                                {
                                    <span class="font-title-md font-semibold">—</span>
                                }
                            </td>
                            <td class="py-space-lg px-space-lg whitespace-nowrap">
                                <div class="flex items-center gap-space-md">
                                    <div class="w-10 h-10 rounded-lg bg-surface-container flex items-center justify-center font-label-sm font-bold text-secondary">@awayCode</div>
                                    <span class="font-title-md font-semibold">@away</span>
                                </div>
                            </td>
                            <td class="py-space-lg px-space-lg">
                                <div class="flex flex-col gap-1 max-w-[200px]">
                                    <div class="flex justify-between font-label-sm font-medium"><span class="text-primary font-bold">@homePoss%</span><span>@awayPoss%</span></div>
                                    <div class="h-2 w-full bg-surface-container-high rounded-full overflow-hidden flex">
                                        <div class="bg-primary h-full" style="width:@(homePoss)%"></div>
                                        <div class="bg-secondary-fixed-dim h-full" style="width:@(awayPoss)%"></div>
                                    </div>
                                </div>
                            </td>
                            <td class="py-space-lg px-space-lg text-right">
                                <div class="inline-flex items-center justify-end gap-space-xs">
                                    <a href="/Admin/Match/Update/@item.MatchId" class="px-space-md py-1 rounded-md bg-surface-container-high text-primary font-label-md font-semibold">Düzenle</a>
                                    <a href="/Admin/Match/Delete/@item.MatchId" class="p-1.5 rounded-md text-on-surface-variant hover:text-error" data-confirm-delete="Bu maç silinsin mi?">
                                        <span class="material-symbols-outlined text-title-md">delete</span>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
