@model ScoreFormViewModel
@{
    ViewData["Title"] = "Yeni Skor Girişi";
    Layout = "~/Areas/Admin/Views/Admin/_IndexLayout.cshtml";
    var home = string.IsNullOrWhiteSpace(Model.HomeTeamName) ? "Ev sahibi" : Model.HomeTeamName;
    var away = string.IsNullOrWhiteSpace(Model.AwayTeamName) ? "Deplasman" : Model.AwayTeamName;
    var homePoss = Model.HomePossession < 0 ? 0 : Model.HomePossession > 100 ? 100 : Model.HomePossession;
    var awayPoss = Model.AwayPossession < 0 ? 0 : Model.AwayPossession > 100 ? 100 : Model.AwayPossession;
}

<div class="flex flex-col w-full gap-space-xl">
    <div>
        <div class="flex items-center gap-space-xs font-label-sm uppercase tracking-wider text-on-surface-variant mb-space-xs">
            <a class="hover:text-primary" href="/Admin/Match">Skorlar</a>
            <span class="material-symbols-outlined text-xs">chevron_right</span>
            <span class="text-primary font-semibold">Yeni Skor Girişi</span>
        </div>
        <h1 class="font-headline-lg text-headline-lg text-primary tracking-tight">Skor ve istatistik kaydı</h1>
        <p class="font-body-md text-on-surface-variant mt-1">Maç sonucu, ilk yarı, ikinci yarı, şut ve topa sahip olma.</p>
    </div>

    <form method="post" class="grid grid-cols-1 xl:grid-cols-12 gap-space-xl">
        <div class="xl:col-span-8 flex flex-col gap-space-xl">
            <div class="bg-white rounded-xl p-space-lg shadow-sm border border-[#d8c1c4] flex flex-col sm:flex-row sm:items-center justify-between gap-space-md">
                <div>
                    <label class="font-label-sm uppercase tracking-wider text-[#534345] font-semibold" for="matchId">Müsabaka</label>
                    <span class="block font-title-md text-[#23191d] font-semibold" id="matchMeta">@(Model.Week). hafta · @Model.StadiumName</span>
                </div>
                <div class="flex flex-col sm:flex-row gap-space-sm">
                <select asp-for="MatchId" class="h-10 px-space-md bg-white text-[#23191d] border border-[#867275] rounded-lg min-w-[280px] focus:outline-none" id="matchId">
                    @if (Model.Matches.Count == 0)
                    {
                        <option value="0">Kayıtlı maç yok</option>
                    }
                    @foreach (var match in Model.Matches)
                    {
                        var itemHome = string.IsNullOrWhiteSpace(match.HomeTeamName) ? "Ev" : match.HomeTeamName;
                        var itemAway = string.IsNullOrWhiteSpace(match.AwayTeamName) ? "Deplasman" : match.AwayTeamName;
                        <option value="@match.MatchId" data-home="@itemHome" data-away="@itemAway" data-meta="@(match.Week). hafta · @match.StadiumName">@itemHome vs @itemAway (@(match.Week). hafta)</option>
                    }
                </select>
                <select asp-for="StatusName" class="h-10 px-space-md rounded-lg bg-white text-[#23191d] border border-[#867275] focus:outline-none">
                    @foreach (var status in Model.Statuses)
                    {
                        <option>@status.StatusName</option>
                    }
                </select>
                </div>
            </div>

            <div class="bg-primary rounded-xl p-space-xl text-white shadow-md">
                <div class="mb-space-lg">
                    <span class="font-label-sm uppercase tracking-widest text-[#ffdfa0]" id="stadiumLabel">@Model.StadiumName</span>
                </div>
                <div class="grid grid-cols-1 md:grid-cols-7 items-center gap-space-md">
                    <div class="md:col-span-3 flex flex-col items-center md:items-end gap-space-sm">
                        <span class="font-headline-md text-white" id="homeName">@home</span>
                        <div class="flex items-center gap-space-xs">
                            <button class="w-9 h-9 rounded-lg bg-[#ffdfa0] text-[#23191d]" type="button" data-step="homeScore" data-dir="-1"><span class="material-symbols-outlined">remove</span></button>
                            <input asp-for="HomeScore" class="w-20 h-20 text-center font-display-lg bg-white text-[#5a192c] rounded-xl border-0 focus:outline-none" id="homeScore" min="0" type="number" />
                            <button class="w-9 h-9 rounded-lg bg-[#ffdfa0] text-[#23191d]" type="button" data-step="homeScore" data-dir="1"><span class="material-symbols-outlined">add</span></button>
                        </div>
                    </div>
                    <div class="md:col-span-1 text-center font-display-lg text-[#ffdfa0]">:</div>
                    <div class="md:col-span-3 flex flex-col items-center md:items-start gap-space-sm">
                        <span class="font-headline-md text-white" id="awayName">@away</span>
                        <div class="flex items-center gap-space-xs">
                            <button class="w-9 h-9 rounded-lg bg-[#ffdfa0] text-[#23191d]" type="button" data-step="awayScore" data-dir="-1"><span class="material-symbols-outlined">remove</span></button>
                            <input asp-for="AwayScore" class="w-20 h-20 text-center font-display-lg bg-white text-[#5a192c] rounded-xl border-0 focus:outline-none" id="awayScore" min="0" type="number" />
                            <button class="w-9 h-9 rounded-lg bg-[#ffdfa0] text-[#23191d]" type="button" data-step="awayScore" data-dir="1"><span class="material-symbols-outlined">add</span></button>
                        </div>
                    </div>
                </div>
            </div>

            <div class="bg-white rounded-xl p-space-lg shadow-sm border border-[#d8c1c4] flex flex-col gap-space-lg">
                <h2 class="font-headline-sm text-primary">Maç istatistikleri</h2>
                <div class="bg-surface-container-low p-space-md rounded-xl">
                    <div class="flex items-center justify-between font-label-md font-semibold text-[#23191d] mb-space-xs">
                        <span>Ev: <span id="homePossLabel">@homePoss</span>%</span>
                        <span class="uppercase text-[#534345]">Topa sahip olma</span>
                        <span>Deplasman: <span id="awayPossLabel">@awayPoss</span>%</span>
                    </div>
                    <div class="w-full h-3 rounded-full bg-surface-container flex overflow-hidden">
                        <div class="h-full bg-primary" id="homePossBar" style="width:@(homePoss)%"></div>
                        <div class="h-full bg-secondary-fixed-dim" id="awayPossBar" style="width:@(awayPoss)%"></div>
                    </div>
                </div>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-space-md">
                    <div class="bg-surface-container-low p-space-md rounded-xl flex flex-col gap-space-sm">
                        <span class="font-label-sm uppercase text-[#23191d] font-semibold">İlk yarı</span>
                        <div class="flex items-center justify-between gap-space-md">
                            <input asp-for="HomeFirstHalfGoals" class="w-16 h-10 text-center rounded-lg bg-white text-[#23191d] font-semibold border border-[#867275] focus:outline-none" min="0" type="number" />
                            <span class="text-[#23191d] font-semibold">-</span>
                            <input asp-for="AwayFirstHalfGoals" class="w-16 h-10 text-center rounded-lg bg-white text-[#23191d] font-semibold border border-[#867275] focus:outline-none" min="0" type="number" />
                        </div>
                    </div>
                    <div class="bg-surface-container-low p-space-md rounded-xl flex flex-col gap-space-sm">
                        <span class="font-label-sm uppercase text-[#23191d] font-semibold">İkinci yarı</span>
                        <div class="flex items-center justify-between gap-space-md">
                            <input asp-for="HomeSecondHalfGoals" class="w-16 h-10 text-center rounded-lg bg-white text-[#23191d] font-semibold border border-[#867275] focus:outline-none" min="0" type="number" />
                            <span class="text-[#23191d] font-semibold">-</span>
                            <input asp-for="AwaySecondHalfGoals" class="w-16 h-10 text-center rounded-lg bg-white text-[#23191d] font-semibold border border-[#867275] focus:outline-none" min="0" type="number" />
                        </div>
                    </div>
                    <div class="bg-surface-container-low p-space-md rounded-xl flex flex-col gap-space-sm">
                        <span class="font-label-sm uppercase text-[#23191d] font-semibold">Şut</span>
                        <div class="flex items-center justify-between gap-space-md">
                            <input asp-for="HomeShots" class="w-16 h-10 text-center rounded-lg bg-white text-[#23191d] font-semibold border border-[#867275] focus:outline-none" min="0" type="number" />
                            <span class="text-[#23191d] font-semibold">-</span>
                            <input asp-for="AwayShots" class="w-16 h-10 text-center rounded-lg bg-white text-[#23191d] font-semibold border border-[#867275] focus:outline-none" min="0" type="number" />
                        </div>
                    </div>
                    <div class="bg-surface-container-low p-space-md rounded-xl flex flex-col gap-space-sm">
                        <span class="font-label-sm uppercase text-[#23191d] font-semibold">İsabetli şut</span>
                        <div class="flex items-center justify-between gap-space-md">
                            <input asp-for="HomeShotsOnTarget" class="w-16 h-10 text-center rounded-lg bg-white text-[#23191d] font-semibold border border-[#867275] focus:outline-none" min="0" type="number" />
                            <span class="text-[#23191d] font-semibold">-</span>
                            <input asp-for="AwayShotsOnTarget" class="w-16 h-10 text-center rounded-lg bg-white text-[#23191d] font-semibold border border-[#867275] focus:outline-none" min="0" type="number" />
                        </div>
                    </div>
                    <div class="bg-surface-container-low p-space-md rounded-xl flex flex-col gap-space-sm md:col-span-2">
                        <span class="font-label-sm uppercase text-[#23191d] font-semibold">Topa sahip olma</span>
                        <div class="flex items-center justify-between gap-space-md">
                            <input asp-for="HomePossession" class="w-20 h-10 text-center rounded-lg bg-white text-[#23191d] font-semibold border border-[#867275] focus:outline-none" id="homePossession" min="0" max="100" type="number" />
                            <span class="text-[#23191d] font-semibold">%</span>
                            <input asp-for="AwayPossession" class="w-20 h-10 text-center rounded-lg bg-white text-[#23191d] font-semibold border border-[#867275] focus:outline-none" id="awayPossession" min="0" max="100" type="number" />
                        </div>
                    </div>
                </div>
            </div>

            <div class="flex items-center justify-end gap-space-md">
                <a href="/Admin/Match" class="px-space-lg py-space-sm rounded-lg bg-white text-[#23191d] border border-[#867275] font-title-md">Vazgeç</a>
                <button class="px-space-xl py-space-sm rounded-lg bg-primary-container text-on-primary font-title-md inline-flex items-center gap-space-sm" type="submit">
                    <span class="material-symbols-outlined">verified</span>
                    Skoru kaydet
                </button>
            </div>
        </div>

        <div class="xl:col-span-4 bg-white rounded-xl p-space-lg shadow-sm border border-[#d8c1c4]">
            <h3 class="font-headline-sm text-primary mb-space-sm">Kayıtta olanlar</h3>
            <p class="font-body-sm text-[#23191d]">Skor ve durum maça yazılır. İlk yarı, ikinci yarı, şut, isabetli şut ve topa sahip olma istatistik kaydına gider. Kart sayıları maç olaylarından gelir.</p>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        (function () {
            var select = document.getElementById("matchId");
            function refreshMatch() {
                if (!select) return;
                var option = select.options[select.selectedIndex];
                if (!option) return;
                var home = document.getElementById("homeName");
                var away = document.getElementById("awayName");
                var meta = document.getElementById("matchMeta");
                var stadium = document.getElementById("stadiumLabel");
                if (home) home.textContent = option.getAttribute("data-home") || "";
                if (away) away.textContent = option.getAttribute("data-away") || "";
                if (meta) meta.textContent = option.getAttribute("data-meta") || "";
                if (stadium) stadium.textContent = (option.getAttribute("data-meta") || "").split("·").pop().trim();
            }
            if (select) {
                select.addEventListener("change", refreshMatch);
                refreshMatch();
            }

            document.querySelectorAll("[data-step]").forEach(function (button) {
                button.addEventListener("click", function () {
                    var input = document.getElementById(button.getAttribute("data-step"));
                    if (!input) return;
                    var value = parseInt(input.value || "0", 10) + parseInt(button.getAttribute("data-dir"), 10);
                    input.value = value < 0 ? 0 : value;
                });
            });

            function paint() {
                var home = document.getElementById("homePossession");
                var away = document.getElementById("awayPossession");
                var homeBar = document.getElementById("homePossBar");
                var awayBar = document.getElementById("awayPossBar");
                var homeLabel = document.getElementById("homePossLabel");
                var awayLabel = document.getElementById("awayPossLabel");
                var h = home ? parseInt(home.value || "0", 10) : 0;
                var a = away ? parseInt(away.value || "0", 10) : 0;
                if (homeBar) homeBar.style.width = h + "%";
                if (awayBar) awayBar.style.width = a + "%";
                if (homeLabel) homeLabel.textContent = h;
                if (awayLabel) awayLabel.textContent = a;
            }
            ["homePossession", "awayPossession"].forEach(function (id) {
                var input = document.getElementById(id);
                if (input) input.addEventListener("input", paint);
            });
        })();
    </script>
}
